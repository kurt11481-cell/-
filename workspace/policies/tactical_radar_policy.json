{
  "schema_version": "1.0",
  "policy_version": "2026-08-12-tactical-opportunity-radar-v2.2",
  "scope": "tactical_candidate_radar",
  "schedule": {"timezone": "Asia/Seoul", "days": ["TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"], "local_time": "07:45", "official_session_gate_required": true, "stale_catchup_prohibited": true},
  "opportunity_states": ["READY", "NEAR_TRIGGER", "WATCH", "NOT_READY", "DATA_BLOCKED"],
  "execution_states": ["ELIGIBLE_FOR_REVIEW", "VERIFICATION_PENDING", "WATCH_ONLY", "NOT_APPROVED", "CASH_BLOCKED", "PORTFOLIO_BLOCKED", "DATA_BLOCKED"],
  "transition_events": ["NEW_READY", "NEW_NEAR_TRIGGER", "OPPORTUNITY_UPGRADE", "OPPORTUNITY_DOWNGRADE", "DATA_BLOCKED", "NO_MATERIAL_CHANGE"],
  "deep_research": {"maximum_candidates": 5, "target_minimum": 3, "run_only_for": ["READY", "NEAR_TRIGGER", "OPPORTUNITY_UPGRADE", "MATERIAL_CHANGE", "USER_REQUEST"], "force_minimum_prohibited": true},
  "technical_authority": {"use_existing_approved_conditions_only": true, "new_numeric_thresholds_prohibited": true, "approved_condition_ids": ["EMA10_RECLAIM_CONFIRMED", "EMA20_RECLAIM_CONFIRMED", "BREAKOUT_ACCEPTANCE_CONFIRMED", "PULLBACK_CONFIRMATION", "EVENT_CLEARANCE", "VALUATION_REFRESH", "EVIDENCE_REFRESH", "THESIS_RESEARCH", "INDEPENDENT_COMPLETED_CLOSE", "PORTFOLIO_REVIEW", "NEXT_COMPLETED_US_SESSION"]},
  "ranking": {"method": "ordered_non_additive_gates", "tie_break_order": ["opportunity_state", "thesis_status", "valuation_status", "risk_liquidity_status", "portfolio_fit_status", "lower_verified_leverage", "stable_active_universe_order"], "universal_master_score_prohibited": true, "preferred_candidate_requires_validated_deep_research": true},
  "notification": {"urgent_transition_events": ["NEW_READY", "NEW_NEAR_TRIGGER", "OPPORTUNITY_UPGRADE", "DATA_BLOCKED"], "unchanged_ready_repeat_prohibited": true, "valid_session_summary_required": true},
  "state_mutation": {"allowed": ["tactical_runtime_state", "audit_log", "research_artifacts", "decision_journal"], "forbidden": ["portfolio_state", "holdings", "cash", "cost_basis", "fills", "policy", "instrument_registry"]},
  "authority": {"order_authority": false, "quantity_authority": false, "broker_state_authority": false, "policy_mutation_authority": false, "human_approval_required": true}
}
