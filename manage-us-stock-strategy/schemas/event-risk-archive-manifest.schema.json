{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-risk-archive-manifest.schema.json",
  "title": "Sanitized current event-risk archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "market_session",
    "analysis_cutoff",
    "hash_basis",
    "bundle_path",
    "bundle_sha256",
    "checkpoint_path",
    "checkpoint_sha256",
    "checkpoint_record_hash",
    "source_evidence_ledger_path",
    "source_evidence_ledger_sha256",
    "portfolio_state_sha256",
    "event_count",
    "category_coverage_count",
    "coverage_status",
    "event_data_status",
    "scheduled_task_consumes_bundle",
    "valid_operational_sessions",
    "provider_readiness_mutated",
    "portfolio_mutated",
    "quantity_authority",
    "order_authority"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "market_session": {"type": "string", "format": "date"},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "hash_basis": {"const": "CANONICAL_JSON_SHA256"},
    "bundle_path": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checkpoint_path": {"type": "string", "minLength": 1},
    "checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checkpoint_record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_evidence_ledger_path": {"type": "string", "minLength": 1},
    "source_evidence_ledger_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "portfolio_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_count": {"type": "integer", "minimum": 0},
    "category_coverage_count": {"type": "integer", "minimum": 0},
    "coverage_status": {
      "enum": [
        "COMPLETE_FOR_REQUIRED_CATEGORIES",
        "PARTIAL_NONBLOCKING",
        "PARTIAL_BLOCKING",
        "SOURCE_UNAVAILABLE",
        "STALE",
        "INVALID"
      ]
    },
    "event_data_status": {"enum": ["COMPLETE", "EVENT_DATA_INCOMPLETE"]},
    "scheduled_task_consumes_bundle": {"type": "boolean"},
    "valid_operational_sessions": {"type": "integer", "minimum": 0},
    "provider_readiness_mutated": {"const": false},
    "portfolio_mutated": {"const": false},
    "quantity_authority": {"const": false},
    "order_authority": {"const": false}
  }
}
