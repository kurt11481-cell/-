{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-event-risk-bundle.schema.json",
  "title": "Current immutable event-risk bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "policy_version",
    "event_policy_hash",
    "active_research_baseline_index_hash",
    "active_research_baselines",
    "market_session",
    "analysis_cutoff",
    "generated_at",
    "retrieval_mode",
    "bundle_status",
    "event_data_status",
    "universe",
    "ticker_coverage",
    "events",
    "provider_readiness_mutated",
    "strategy_state_mutated",
    "quantity_authority",
    "order_authority"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "event_policy_hash": {"type": "string", "pattern": "[0-9A-Fa-f]{64}"},
    "active_research_baseline_index_hash": {"type": "string", "pattern": "[0-9A-Fa-f]{64}"},
    "active_research_baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "baseline_id", "baseline_hash"],
        "properties": {
          "ticker": {"type": "string", "minLength": 1},
          "baseline_id": {"type": "string", "minLength": 1},
          "baseline_hash": {"type": "string", "pattern": "[0-9A-Fa-f]{64}"}
        }
      }
    },
    "market_session": {"type": "string", "format": "date"},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "retrieval_mode": {"const": "LIVE_FORWARD_CAPTURE"},
    "bundle_status": {
      "enum": ["COMPLETE", "PARTIAL", "EVENT_REVIEW_REQUIRED", "UNAVAILABLE", "INVALID"]
    },
    "event_data_status": {"enum": ["COMPLETE", "EVENT_DATA_INCOMPLETE"]},
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "supplemental"],
      "properties": {
        "direct": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "supplemental": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "ticker_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker", "instrument_role", "status", "event_ids", "checked_source_types",
          "missing_fields", "event_data_incomplete", "strategy_effect", "notes"
        ],
        "properties": {
          "ticker": {"type": "string", "minLength": 1},
          "instrument_role": {"enum": ["DIRECT", "SUPPLEMENTAL"]},
          "status": {"enum": ["COMPLETE", "PARTIAL", "EVENT_REVIEW_REQUIRED", "UNAVAILABLE", "INVALID"]},
          "event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "checked_source_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "missing_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "event_data_incomplete": {"type": "boolean"},
          "strategy_effect": {"enum": ["CONTEXT_ONLY", "EVENT_REVIEW_PENDING", "DATA_BLOCKED"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id", "ticker", "instrument_role", "event_type", "source_url", "source_type",
          "published_at", "published_at_precision", "effective_at", "effective_at_precision",
          "retrieved_at", "first_seen_at", "analysis_cutoff", "point_in_time_eligible",
          "severity", "strategy_relevance", "verification_status", "policy_effect",
          "applies_to", "supplemental_context_for", "evidence_summary"
        ],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "ticker": {"type": "string", "minLength": 1},
          "instrument_role": {"enum": ["DIRECT", "SUPPLEMENTAL", "GLOBAL"]},
          "event_type": {
            "enum": [
              "EARNINGS_RELEASE", "EARNINGS_SCHEDULE", "GUIDANCE", "FINANCING", "DILUTION",
              "MAJOR_CUSTOMER_OR_CONTRACT", "CORPORATE_ACTION", "ETF_PRODUCT_STRUCTURE",
              "ETF_SPLIT_OR_REVERSE_SPLIT", "EX_DIVIDEND", "DELISTING_OR_TRADING_HALT",
              "REGULATORY", "INVESTOR_DAY", "FOMC_DECISION", "CPI", "PPI", "PCE",
              "EMPLOYMENT_REPORT", "MONTHLY_OPTIONS_EXPIRATION"
            ]
          },
          "source_url": {"type": "string", "format": "uri"},
          "source_type": {"enum": ["SEC", "ISSUER_IR", "ETF_SPONSOR", "EXCHANGE", "REGULATOR", "GOVERNMENT"]},
          "published_at": {"type": ["string", "null"], "format": "date-time"},
          "published_at_precision": {"enum": ["EXACT", "DATE_CONSERVATIVE_END_UTC", "FIRST_SEEN_AT_CUTOFF", "UNKNOWN"]},
          "effective_at": {"type": ["string", "null"], "format": "date-time"},
          "effective_at_precision": {"enum": ["EXACT", "DATE_CONSERVATIVE_END_UTC", "SESSION_DATE", "UNKNOWN"]},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "first_seen_at": {"type": "string", "format": "date-time"},
          "analysis_cutoff": {"type": "string", "format": "date-time"},
          "point_in_time_eligible": {"type": "boolean"},
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "strategy_relevance": {"type": "string", "minLength": 1},
          "verification_status": {"enum": ["VERIFIED", "PARTIAL", "UNVERIFIED", "REJECTED"]},
          "policy_effect": {"enum": ["CONTEXT_ONLY", "WAIT_REQUIRED", "EVENT_REVIEW_REQUIRED"]},
          "applies_to": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "supplemental_context_for": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "provider_readiness_mutated": {"const": false},
    "strategy_state_mutated": {"const": false},
    "quantity_authority": {"const": false},
    "order_authority": {"const": false}
  }
}
