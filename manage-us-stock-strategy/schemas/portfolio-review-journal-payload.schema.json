{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision journal entry payload (S5 activation, line review, peak review, card decision, card user decision)",
  "description": "One object shape for all entry types; the fields present depend on entry_type (portfolio_review_journal.py checks the exact field set per type). S5 values are copied from one portfolio exposure review; card values come from a card that passed validate_holding_card. A card_decision proposal payload holds card_id, card_sha256, fact_pack_sha256 and decisions (a list of card_decision entry payloads). Human entries carry no quantity, price target or order field. Redesign T2 F7: the auto-core's order_ticket payload records the ticket the user may enter (LOC price and quantity) with its authority block (quantity_authority ORDER_TICKET_HUMAN_ENTRY, order_authority false, execution_quantity null); ticket_outcome records the broker-classified result; core_decision records one decide run (no action included).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activation_date": {"type": "string", "format": "date"},
    "hwm_usd": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "hwm_as_of": {"type": "string", "format": "date"},
    "hwm_policy_initial_usd": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "hwm_difference_usd": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "state_revision": {"type": "integer", "minimum": 0},
    "window_start": {"type": "string", "format": "date"},
    "window_end": {"type": "string", "format": "date"},
    "close_basis": {"const": "FINAL_REGULAR_SESSION_30M_BAR_CLOSE"},
    "line_id": {"type": "string", "pattern": "^L[0-9]+$"},
    "hwm": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "breach_date": {"type": "string", "format": "date"},
    "review_status": {"const": "completed"},
    "conclusion": {"enum": ["continue", "other"]},
    "conclusion_note": {"type": "string"},
    "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,11}$"},
    "peak": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "peak_date": {"type": "string", "format": "date"},
    "card_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fact_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "decision_as_of": {"type": "string", "format": "date-time"},
    "decision_session": {"type": "string", "format": "date"},
    "analysis_action": {"enum": ["ADD", "HOLD", "TRIM", "EXIT"]},
    "sidecar_action": {"enum": [
      "HOLD_CORE", "HOLD_TIGHTEN_STOP", "HOLD_REVIEW_REQUIRED", "ADD_REVIEW", "TRIM_PROFIT", "TRIM_VALUATION",
      "TRIM_TECHNICAL", "TRIM_CONCENTRATION", "TRIM_RISK", "EXIT_THESIS", "EXIT_HARD_STOP", "ROTATE_REVIEW",
      "KEEP_CASH"
    ]},
    "conviction": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "reference_close": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "evidence_grade": {"type": ["string", "null"]},
    "card_state_revision": {"type": ["integer", "null"], "minimum": 0},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "user_action": {"enum": ["ADD", "HOLD", "TRIM", "EXIT", "OTHER"]},
    "effective_session": {"type": "string", "format": "date"},
    "user_note": {"type": "string"},
    "run_day_kst": {"type": "string", "format": "date"},
    "buy_session": {"type": "string", "format": "date"},
    "decision_mode": {"const": "apply"},
    "no_action": {"type": "boolean"},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "ticket_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AT-[0-9]{8}-[A-Z0-9.]{1,12}-[0-9]+$"}},
    "commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ticket_id": {"type": "string", "pattern": "^AT-[0-9]{8}-[A-Z0-9.]{1,12}-[0-9]+$"},
    "side": {"enum": ["buy", "sell"]},
    "order_type": {"const": "LOC"},
    "price": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "qty": {"type": "integer", "minimum": 1},
    "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "decision_key": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "price_rule": {"type": "string", "minLength": 1},
    "evidence_r": {"enum": ["1/3", "1/2", "1"]},
    "risk_1r": {
      "description": "risk1r (optional, order_ticket of a buy only): the planned 1R copied from the ticket (EMA20 - 0.75 ATR14 invalidation, grade D, display and record only).",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "invalidation", "r_pct", "r_sigma", "loss_pct_equity", "grade"],
      "properties": {
        "status": {"enum": ["ok", "below_band", "unk"]},
        "invalidation": {"type": ["string", "null"], "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
        "r_pct": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "r_sigma": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "loss_pct_equity": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "grade": {"const": "D"}
      }
    },
    "evidence_weak_kinds": {"description": "risk1r (optional, order_ticket): the ticket's evidence.weak kinds as they are.", "type": "array", "items": {"type": "string"}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_authority", "quantity_authority", "execution_quantity"],
      "properties": {
        "order_authority": {"const": false},
        "quantity_authority": {"const": "ORDER_TICKET_HUMAN_ENTRY"},
        "execution_quantity": {"type": "null"}
      }
    },
    "outcome_state": {"enum": ["filled", "partial", "unfilled", "not_entered", "changed"]},
    "filled_qty": {"type": "integer", "minimum": 0},
    "average_fill_price": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "classified_on": {"type": "string", "format": "date"}
  }
}
