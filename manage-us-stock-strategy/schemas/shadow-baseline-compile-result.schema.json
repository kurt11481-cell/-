{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadow-baseline-compile-result.schema.json",
  "title": "Non-Authoritative Holding Baseline Shadow Compile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "ticker", "candidate_baseline_id", "candidate_baseline_hash", "valuation_snapshot_id", "valuation_snapshot_hash", "event_link_id", "event_link_hash", "overlay_hash", "portfolio_state_revision", "portfolio_state_hash", "policy_hash", "provider_scope_hash", "thesis_status", "valuation_evidence_status", "valuation_judgement_status", "technical_status", "event_status", "risk_status", "portfolio_fit_status", "strategy_signal", "primary_reason", "strongest_counter_case", "invalidation", "next_review_trigger", "remaining_conditions", "shadow_compile_status", "live_strategy_state", "shadow_strategy_state", "blocked_decision_classes", "quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.6.12"},
    "mode": {"const": "NON_AUTHORITATIVE_SHADOW"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "candidate_baseline_id": {"type": "string", "minLength": 1},
    "candidate_baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "valuation_snapshot_id": {"type": ["string", "null"]},
    "valuation_snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "event_link_id": {"type": "string", "minLength": 1},
    "event_link_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "overlay_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "portfolio_state_revision": {"type": "integer", "minimum": 0},
    "portfolio_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_scope_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "thesis_status": {"enum": ["VALID", "CONTESTED", "INVALIDATED", "STALE", "UNVERIFIED"]},
    "valuation_evidence_status": {"enum": ["UNVERIFIED", "PARTIAL", "SCENARIO_VALIDATED", "PRICE_EVIDENCE_CONFLICT", "STALE", "INVALID", "NOT_APPLICABLE"]},
    "valuation_judgement_status": {"enum": ["ATTRACTIVE", "FAIR", "STRETCHED", "UNCLASSIFIED", "UNVERIFIED", "NOT_APPLICABLE"]},
    "technical_status": {"enum": ["READY", "WATCH", "DETERIORATING", "INVALID", "UNAVAILABLE"]},
    "event_status": {"enum": ["CLEAR", "CONTEXT_ONLY", "EVENT_REVIEW_PENDING", "WAIT_REQUIRED", "INVALID"]},
    "risk_status": {"enum": ["ACCEPTABLE", "CONSTRAINED", "HARD_RISK", "VETO", "UNVERIFIED"]},
    "portfolio_fit_status": {"enum": ["FITS", "CONSTRAINED", "BLOCKED", "UNVERIFIED"]},
    "strategy_signal": {"enum": ["NONE", "ADD_CANDIDATE", "REDUCE_CANDIDATE", "EXIT_CANDIDATE"]},
    "primary_reason": {"type": "string", "minLength": 1},
    "strongest_counter_case": {"type": "string", "minLength": 1},
    "invalidation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "next_review_trigger": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "remaining_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "shadow_compile_status": {"enum": ["PASSED", "PENDING", "FAILED"]},
    "live_strategy_state": {"type": "string", "minLength": 1},
    "shadow_strategy_state": {"enum": ["HOLD", "ADD_ON_WATCH", "ADD_REVIEW", "REDUCTION_REVIEW", "EXIT_REVIEW", "STRATEGY_REFRESH_REQUIRED", "DATA_BLOCKED"]},
    "blocked_decision_classes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "quantity": {"const": null},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  }
}
