{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEC Scheduled Shadow derived summary v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_mode",
    "run_id",
    "schedule_status",
    "pipeline_status",
    "pipeline_version",
    "run_started_at",
    "run_finished_at",
    "decision_as_of",
    "freshness_status",
    "filings_in_lookback_window",
    "high_filings_in_lookback_window",
    "previous_run_id",
    "previous_run_as_of",
    "diff_status",
    "new_since_previous_count",
    "new_high_since_previous_count",
    "diff_identity",
    "lookback_days",
    "watchlist",
    "source",
    "schedule_contract_sha256",
    "current_normalized_sha256",
    "current_run_manifest_sha256",
    "previous_normalized_sha256",
    "previous_run_manifest_sha256",
    "user_agent_source",
    "plaintext_artifact_storage",
    "historical_artifact_mutation",
    "order_authority",
    "execution_quantity",
    "automatic_order"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_mode": {"const": "SCHEDULED_SHADOW"},
    "run_id": {"type": "string", "minLength": 1},
    "schedule_status": {"enum": ["PASS", "PARTIAL", "NO_NEW_FILINGS"]},
    "pipeline_status": {"enum": ["PASS", "PARTIAL"]},
    "pipeline_version": {"const": "0.1"},
    "run_started_at": {"type": "string", "format": "date-time"},
    "run_finished_at": {"type": "string", "format": "date-time"},
    "decision_as_of": {"type": "string", "format": "date-time"},
    "freshness_status": {"const": "CURRENT_RUN"},
    "filings_in_lookback_window": {"type": "integer", "minimum": 0},
    "high_filings_in_lookback_window": {"type": "integer", "minimum": 0},
    "previous_run_id": {"type": ["string", "null"]},
    "previous_run_as_of": {"type": ["string", "null"]},
    "diff_status": {"enum": ["PASS", "BASELINE_ONLY", "PREVIOUS_RUN_INCOMPATIBLE", "PREVIOUS_RUN_NOT_FOUND"]},
    "new_since_previous_count": {"type": ["integer", "null"], "minimum": 0},
    "new_high_since_previous_count": {"type": ["integer", "null"], "minimum": 0},
    "diff_identity": {"const": "ticker+accession_number"},
    "lookback_days": {"type": "integer", "minimum": 1},
    "watchlist": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source": {"const": "SEC"},
    "schedule_contract_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "current_normalized_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "current_run_manifest_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "previous_normalized_sha256": {"type": ["string", "null"], "pattern": "[0-9a-f]{64}"},
    "previous_run_manifest_sha256": {"type": ["string", "null"], "pattern": "[0-9a-f]{64}"},
    "user_agent_source": {"const": "ENVIRONMENT_VARIABLE"},
    "plaintext_artifact_storage": {"const": false},
    "historical_artifact_mutation": {"const": false},
    "order_authority": {"const": false},
    "execution_quantity": {"const": null},
    "automatic_order": {"const": false}
  }
}
