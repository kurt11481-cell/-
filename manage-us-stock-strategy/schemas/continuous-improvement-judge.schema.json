{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuous-improvement-judge.schema.json",
  "type": "object",
  "required": ["schema_version", "analytics_engine_version", "metric_definition_version", "judge_mode", "overall_status", "gates", "schema_errors", "portfolio_hash_expected", "portfolio_hash_actual", "operational_progress_hash_expected", "operational_progress_hash_actual", "scheduler_hash_before", "scheduler_hash_after", "test_output_hash", "execution_quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "analytics_engine_version": {"const": "continuous-improvement-engine-2.0"},
    "metric_definition_version": {"const": "continuous-improvement-metrics-2.0"},
    "judge_mode": {"const": "INDEPENDENT_READ_ONLY"},
    "overall_status": {"enum": ["CONTINUOUS_IMPROVEMENT_PIPELINE_VERIFIED", "CONTINUOUS_IMPROVEMENT_PIPELINE_NOT_READY"]},
    "gates": {"type": "object", "additionalProperties": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]}},
    "schema_errors": {"type": "array"},
    "portfolio_hash_expected": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "portfolio_hash_actual": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "operational_progress_hash_expected": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "operational_progress_hash_actual": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "scheduler_hash_before": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "scheduler_hash_after": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "test_output_hash": {"type": ["string", "null"]},
    "execution_quantity": {"type": "null"},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  },
  "additionalProperties": false
}
