{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "broker-snapshot-upload.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "authority_state", "page_count", "pages", "contains_sensitive_login_or_otp", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.5"}, "bundle_id": {"type": "string"},
    "authority_state": {"const": "UNTRUSTED_USER_SUPPLIED_EVIDENCE"},
    "page_count": {"type": "integer", "minimum": 1},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "contains_sensitive_login_or_otp": {"type": "boolean"}, "order_authority": {"const": false}
  }
}
