{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regular-session close history built from saved Kiwoom 30-minute bar pages (S5 R1/R4, evidence only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "symbol", "exchange", "source", "close_definition", "calendar", "pages",
    "sessions", "first_session", "last_session", "session_count", "continuity", "calendar_out_of_coverage_dates",
    "order_authority", "quantity_authority", "history_hash"
  ],
  "properties": {
    "schema_version": {"const": "regular-session-close-history-1.0"},
    "artifact_type": {"const": "REGULAR_SESSION_CLOSE_HISTORY"},
    "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,11}$"},
    "exchange": {"enum": ["NASDAQ", "NYSE", "AMEX"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "api_id", "collection", "interval_minutes", "price_adjustment", "bar_label_basis"],
      "properties": {
        "provider": {"const": "KIWOOM"},
        "api_id": {"const": "usa06011"},
        "collection": {"const": "COWORK_READ_ONLY_CLI_EVIDENCE_FILE"},
        "interval_minutes": {"const": 30},
        "price_adjustment": {"const": "RAW_UNADJUSTED"},
        "bar_label_basis": {"const": "BAR_START_TIME_US_EASTERN"}
      }
    },
    "close_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "bar_selection", "label", "official_close", "reference_close_use"],
      "properties": {
        "basis": {"const": "FINAL_REGULAR_SESSION_30M_BAR_CLOSE"},
        "bar_selection": {"const": "BAR_STARTING_30_MINUTES_BEFORE_CORE_CLOSE"},
        "label": {"const": "APPROXIMATE_CLOSE"},
        "official_close": {"const": false},
        "reference_close_use": {"const": "DIFFERENCE_DISPLAY_ONLY"}
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar_version", "calendar_sha256", "coverage_start", "coverage_end", "authority_status"],
      "properties": {
        "calendar_version": {"type": "string", "minLength": 1},
        "calendar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_start": {"type": "string", "format": "date"},
        "coverage_end": {"type": "string", "format": "date"},
        "authority_status": {"enum": ["ACTIVE", "EXPLICIT_ARTIFACT_NOT_ACTIVE"]}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_name", "sha256", "row_count", "first_cntr_tm", "last_cntr_tm"],
        "properties": {
          "file_name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "row_count": {"type": "integer", "minimum": 1},
          "first_cntr_tm": {"type": "string", "pattern": "^[0-9]{14}$"},
          "last_cntr_tm": {"type": "string", "pattern": "^[0-9]{14}$"}
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_date", "close", "bar_cntr_tm", "close_type", "page_sha256", "verified", "unverified_reasons"
        ],
        "properties": {
          "session_date": {"type": "string", "format": "date"},
          "close": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "bar_cntr_tm": {"type": "string", "pattern": "^[0-9]{14}$"},
          "close_type": {"enum": ["REGULAR", "EARLY"]},
          "page_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "verified": {"type": "boolean"},
          "unverified_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reference_close": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "reference_difference": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}
        }
      }
    },
    "first_session": {"type": "string", "format": "date"},
    "last_session": {"type": "string", "format": "date"},
    "session_count": {"type": "integer", "minimum": 1},
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missing_sessions"],
      "properties": {
        "status": {"enum": ["CONTIGUOUS", "GAPS"]},
        "missing_sessions": {"type": "array", "items": {"type": "string", "format": "date"}}
      }
    },
    "calendar_out_of_coverage_dates": {"type": "array", "items": {"type": "string", "format": "date"}},
    "order_authority": {"const": false},
    "quantity_authority": {"const": "none"},
    "history_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
