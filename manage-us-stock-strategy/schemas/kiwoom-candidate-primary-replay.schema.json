{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kiwoom-candidate-primary-replay.schema.json",
  "title": "Kiwoom Candidate-Primary Replay Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "replay_mode", "official_sessions", "tickers", "historical_replay_sessions", "case_count", "market_data_provider_replay", "full_strategy_context_replay", "counts", "ticker_failures", "historical_backfill_generated", "provider_authority_changed", "valid_operational_sessions_increment", "order_authority", "summary_hash", "input_hashes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "replay_mode": {"const": "REPLAY_VALIDATION_ONLY"},
    "official_sessions": {"type": "array", "minItems": 20, "uniqueItems": true, "items": {"type": "string", "format": "date"}},
    "tickers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "historical_replay_sessions": {"type": "integer", "minimum": 20},
    "case_count": {"type": "integer", "minimum": 1},
    "market_data_provider_replay": {"enum": ["PASS", "PARTIAL", "FAIL"]},
    "full_strategy_context_replay": {"enum": ["COMPLETE", "PARTIAL_EXPECTED_NO_ARCHIVE", "UNAVAILABLE", "INVALID"]},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_evaluated", "raw_matches", "raw_conflicts", "kiwoom_technical_evaluated", "kiwoom_technical_pass", "yfinance_technical_evaluated", "yfinance_technical_pass", "adjusted_explicitly_classified", "adjusted_same_basis_conflicts", "technical_decision_flips"],
      "properties": {
        "raw_evaluated": {"type": "integer", "minimum": 0}, "raw_matches": {"type": "integer", "minimum": 0}, "raw_conflicts": {"type": "integer", "minimum": 0},
        "kiwoom_technical_evaluated": {"type": "integer", "minimum": 0}, "kiwoom_technical_pass": {"type": "integer", "minimum": 0},
        "yfinance_technical_evaluated": {"type": "integer", "minimum": 0}, "yfinance_technical_pass": {"type": "integer", "minimum": 0},
        "adjusted_explicitly_classified": {"type": "integer", "minimum": 0}, "adjusted_same_basis_conflicts": {"type": "integer", "minimum": 0},
        "technical_decision_flips": {"type": "integer", "minimum": 0}
      }
    },
    "ticker_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "historical_backfill_generated": {"const": false},
    "provider_authority_changed": {"const": false},
    "valid_operational_sessions_increment": {"const": 0},
    "order_authority": {"const": false},
    "summary_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
