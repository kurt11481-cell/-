{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-record.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claim",
    "record_type",
    "source_url",
    "source_type",
    "published_at_utc",
    "retrieved_at_utc",
    "effective_at_utc",
    "confidence",
    "actionable"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^E[0-9]+$"},
    "claim": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["VERIFIED_FACT", "CALCULATION", "INFERENCE", "ASSUMPTION", "SCENARIO"]},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "source_type": {"enum": ["primary", "market_data", "secondary", "social", "user_provided_unverified", "calculation"]},
    "published_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "retrieved_at_utc": {"type": "string", "format": "date-time"},
    "effective_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "observation_session": {"type": ["string", "null"], "format": "date"},
    "units": {"type": ["string", "null"]},
    "price_basis": {"type": ["string", "null"]},
    "formula_version": {"type": ["string", "null"]},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "contradiction_status": {"enum": ["NONE", "OPEN", "RESOLVED"]},
    "actionable": {"type": "boolean"},
    "notes": {"type": ["string", "null"]}
  }
}
