{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unified-run-ledger.schema.json",
  "type": "object",
  "required": ["schema_version", "analytics_engine_version", "metric_definition_version", "ledger_mode", "improvement_analytics_cohort", "entries", "last_record_hash", "order_authority"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "analytics_engine_version": {"const": "continuous-improvement-engine-3.0"},
    "metric_definition_version": {"const": "continuous-improvement-metrics-3.0"},
    "ledger_mode": {"const": "APPEND_ONLY_SIDECAR"},
    "improvement_analytics_cohort": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "items": {"$ref": "continuous-improvement-run-record.schema.json"}},
    "last_record_hash": {"type": ["string", "null"]},
    "order_authority": {"const": false}
  },
  "additionalProperties": false
}
