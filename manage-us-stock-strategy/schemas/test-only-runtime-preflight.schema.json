{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stock-strategy.test/schemas/test-only-runtime-preflight.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at",
    "status",
    "failure_injection",
    "deployment_provenance_status",
    "calendar_status",
    "phase_status",
    "kiwoom_readonly_preflight_status",
    "clock_status",
    "runtime_head",
    "runtime_tree",
    "runtime_clean",
    "protected_hashes_before",
    "protected_hashes_after",
    "protected_state_unchanged",
    "portfolio_effect",
    "core_counter_effect",
    "genuine_artifact_created",
    "test_only",
    "maturity_eligible",
    "production_runtime_invoked",
    "order_authority",
    "quantity_authority",
    "execution_quantity",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "TEST_ONLY_RUNTIME_PREFLIGHT" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL_CLOSED"] },
    "failure_injection": {
      "enum": [
        "NONE",
        "INVALID_DEPLOYMENT_IDENTITY",
        "CLOSED_MARKET_SESSION",
        "PHASE_MISMATCH",
        "KIWOOM_PREFLIGHT_UNAVAILABLE",
        "CLOCK_INTEGRITY_FAILURE"
      ]
    },
    "deployment_provenance_status": { "enum": ["VERIFIED", "FAILED"] },
    "calendar_status": { "enum": ["VERIFIED", "FAILED"] },
    "phase_status": { "enum": ["TEST_ONLY_PREFLIGHT_ONLY", "PHASE_MISMATCH"] },
    "kiwoom_readonly_preflight_status": { "enum": ["AVAILABLE", "UNAVAILABLE"] },
    "clock_status": { "enum": ["VERIFIED", "FAILED"] },
    "runtime_head": { "type": ["string", "null"] },
    "runtime_tree": { "type": ["string", "null"] },
    "runtime_clean": { "type": "boolean" },
    "protected_hashes_before": { "type": "object", "additionalProperties": { "type": "string" } },
    "protected_hashes_after": { "type": "object", "additionalProperties": { "type": "string" } },
    "protected_state_unchanged": { "type": "boolean" },
    "portfolio_effect": { "const": "NONE" },
    "core_counter_effect": { "const": "NONE" },
    "genuine_artifact_created": { "const": false },
    "test_only": { "const": true },
    "maturity_eligible": { "const": false },
    "production_runtime_invoked": { "const": false },
    "order_authority": { "const": false },
    "quantity_authority": { "const": "none" },
    "execution_quantity": { "type": "null" },
    "artifact_hash": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
