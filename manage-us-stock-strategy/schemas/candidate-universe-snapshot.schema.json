{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-universe-snapshot.schema.json",
  "type": "object",
  "required": ["schema_version", "artifact_type", "universe_role", "candidate_universe_as_of", "availability_status", "instrument_identities", "survivorship_reconstruction_forbidden", "candidate_universe_hash", "order_authority"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "CANDIDATE_UNIVERSE_SNAPSHOT"},
    "universe_role": {"const": "CANDIDATE_OPPORTUNITY_UNIVERSE"},
    "candidate_universe_as_of": {"type": "string", "format": "date-time"},
    "availability_status": {"enum": ["AVAILABLE_AT_DECISION_TIME", "UNAVAILABLE_AT_DECISION_TIME"]},
    "instrument_identities": {"type": "array"},
    "survivorship_reconstruction_forbidden": {"const": true},
    "candidate_universe_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "order_authority": {"const": false}
  },
  "additionalProperties": true
}
