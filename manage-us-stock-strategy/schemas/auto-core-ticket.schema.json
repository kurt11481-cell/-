{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto-core-ticket.schema.json",
  "title": "Auto-core order ticket (decision.json tickets[])",
  "description": "Redesign T2 F5, order stage 1 (ORDER_INTENT). A LOC quantity and price the user may enter in Kiwoom; valid for one U.S. session. Only a ticket carries quantity_authority ORDER_TICKET_HUMAN_ENTRY; order_authority is false and execution_quantity null. In compare mode a ticket is 'comparing, not for entry'. Fills are classified the next morning from broker fill rows only. Regret rows include every step 0, 1/3, 1/2, 1; the chosen step never exceeds evidence.r_max.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "mode", "issuedAt", "session", "enterWindow", "fillAt", "ref", "ifUnfilled", "ticker", "side", "type", "price", "priceRule", "priceCalc", "qty", "amount", "feeRate", "check_line", "reason", "evidence", "gates", "regret", "decision_key", "inputs", "authority", "gap"],
  "properties": {
    "ticket_id": {"type": "string", "pattern": "^AT-[0-9]{8}-[A-Z0-9.]{1,12}-[0-9]+$"},
    "mode": {"enum": ["compare", "apply"]},
    "issuedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} KST$"},
    "session": {"type": "string", "format": "date"},
    "enterWindow": {"type": "string", "minLength": 1},
    "fillAt": {"type": "string", "minLength": 1},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "label"],
      "properties": {"price": {"type": "number", "minimum": 0}, "label": {"type": "string", "minLength": 1}}
    },
    "ifUnfilled": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,11}$"},
    "side": {"enum": ["buy", "sell"]},
    "type": {"const": "LOC"},
    "price": {"type": "number", "minimum": 0},
    "priceRule": {"type": "string", "minLength": 1},
    "priceCalc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mult", "round", "lo", "hi", "label"],
      "properties": {
        "mult": {"type": "number", "minimum": 0},
        "round": {"enum": ["up", "down"]},
        "lo": {"type": "number", "minimum": 0},
        "hi": {"type": "number", "minimum": 0},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "qty": {"type": "integer", "minimum": 1},
    "amount": {"type": "number", "minimum": 0},
    "feeRate": {"type": "number", "minimum": 0},
    "check_line": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strong", "weak", "composition", "r_max", "r"],
      "properties": {
        "strong": {"type": "array", "items": {"type": "string"}},
        "weak": {"type": "array", "items": {"type": "string"}},
        "composition": {"type": "string"},
        "r_max": {"enum": ["0", "1/3", "1/2", "1"]},
        "r": {"enum": ["1/3", "1/2", "1"]}
      }
    },
    "gates": {
      "type": "object",
      "required": ["G0", "G1", "G2", "G2b", "G3", "G4", "G5"]
    },
    "regret": {
      "type": "object",
      "required": ["rows", "tail_rows", "columns", "budget", "chosen", "why"],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["r", "qty", "regret", "max_regret", "max_regret_pct"],
            "properties": {
              "r": {"enum": ["0", "1/3", "1/2", "1"]},
              "qty": {"type": "integer", "minimum": 0},
              "regret": {"type": "object"},
              "max_regret": {"type": "number"},
              "max_regret_pct": {"type": "number"}
            }
          }
        },
        "tail_rows": {"type": "array"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "budget": {"type": "number"},
        "chosen": {"enum": ["1/3", "1/2", "1"]},
        "why": {"enum": ["WITHIN_REGRET_BUDGET", "MINIMAX_REGRET"]}
      }
    },
    "decision_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "object"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_authority", "quantity_authority", "execution_quantity"],
      "properties": {
        "order_authority": {"const": false},
        "quantity_authority": {"const": "ORDER_TICKET_HUMAN_ENTRY"},
        "execution_quantity": {"type": "null"}
      }
    },
    "gap": {"type": "object", "required": ["source", "target_weight", "delta"]},
    "after_sale": {"type": "object"},
    "risk_1r": {
      "description": "risk1r (user decision ext-1012-setup B, 2026-10-12): buy tickets only. 1R = loss down to the invalidation line EMA20 - 0.75 ATR14 of the evaluation session (cent down). Grade D, display and record only: never an input to a gate, quantity, price or sell. status unk = an indicator is missing or invalid; below_band = the reference is at or below the line.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "invalidation", "r_pct", "r_sigma", "loss_usd", "loss_pct_equity", "basis", "grade", "display_only", "line"],
      "properties": {
        "status": {"enum": ["ok", "below_band", "unk"]},
        "reason": {"type": ["string", "null"]},
        "invalidation": {"type": ["string", "null"], "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
        "r_pct": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "r_sigma": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "loss_usd": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "loss_pct_equity": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "basis": {"const": "EMA20-0.75xATR14@evaluation_session"},
        "grade": {"const": "D"},
        "display_only": {"const": true},
        "line": {"type": "string", "minLength": 1}
      }
    },
    "note": {"type": "string"}
  }
}
