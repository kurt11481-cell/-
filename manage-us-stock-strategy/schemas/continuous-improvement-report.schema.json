{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuous-improvement-report.schema.json",
  "type": "object",
  "required": ["schema_version", "analytics_engine_version", "metric_definition_version", "mode", "validation_mode", "status", "analytics_as_of", "run_counts", "maturity_eligible_count", "ledger_chain_valid", "temporal_evidence", "forward_outcomes", "outcome_ledger", "outcome_ledger_chain_valid", "outcome_duplicate_count", "horizon_counts", "decision_quality", "blocked_opportunity_review", "counterfactual_evaluation", "decision_stability", "drift_monitoring", "operational_analytics", "improvement_findings", "policy_change_proposals", "shadow_policy_experiments", "analytics_failure_affects_core_scheduled_run", "live_api_calls", "portfolio_mutation", "production_policy_mutation", "operational_counter_mutation", "portfolio_decision_counter_mutation", "core_operational_counter_mutation", "execution_authority_status", "execution_quantity", "quantity_authority", "order_authority", "report_hash"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "analytics_engine_version": {"const": "continuous-improvement-engine-2.0"},
    "metric_definition_version": {"const": "continuous-improvement-metrics-2.0"},
    "mode": {"const": "CONTINUOUS_IMPROVEMENT_SIDECAR"},
    "validation_mode": {"enum": ["TEST_ONLY", "LIVE_SIDECAR"]},
    "status": {"enum": ["CONTINUOUS_IMPROVEMENT_PIPELINE_VERIFIED", "CONTINUOUS_IMPROVEMENT_PIPELINE_NOT_READY"]},
    "analytics_as_of": {"type": "string", "format": "date-time"},
    "run_counts": {"type": "object"},
    "maturity_eligible_count": {"type": "integer", "minimum": 0},
    "ledger_chain_valid": {"type": "boolean"},
    "temporal_evidence": {"type": "object"},
    "forward_outcomes": {"type": "array"},
    "outcome_ledger": {"type": "object"},
    "outcome_ledger_chain_valid": {"type": "boolean"},
    "outcome_duplicate_count": {"type": "integer", "minimum": 0},
    "horizon_counts": {"type": "object"},
    "decision_quality": {"type": "object"},
    "blocked_opportunity_review": {"type": "object"},
    "counterfactual_evaluation": {"type": "object"},
    "decision_stability": {"type": "object"},
    "drift_monitoring": {"type": "object"},
    "operational_analytics": {"type": "object"},
    "improvement_findings": {"type": "array"},
    "policy_change_proposals": {"type": "array"},
    "shadow_policy_experiments": {"type": "array"},
    "analytics_failure_affects_core_scheduled_run": {"const": false},
    "live_api_calls": {"const": 0},
    "portfolio_mutation": {"const": false},
    "production_policy_mutation": {"const": false},
    "operational_counter_mutation": {"const": false},
    "portfolio_decision_counter_mutation": {"const": false},
    "core_operational_counter_mutation": {"const": false},
    "execution_authority_status": {"const": "NONE"},
    "execution_quantity": {"type": "null"},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false},
    "report_hash": {"type": "string", "pattern": "[0-9a-f]{64}"}
  },
  "additionalProperties": true
}
