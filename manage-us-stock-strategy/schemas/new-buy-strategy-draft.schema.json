{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "new-buy-strategy-draft.schema.json",
  "title": "Deterministic New-Buy Strategy Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ticker", "legal_issuer_name", "instrument_type", "leveraged_status", "analysis_cutoff", "market_session", "research_packet_hash", "thesis_status", "valuation_status", "technical_status", "event_risk_status", "risk_liquidity_status", "portfolio_fit_status", "opportunity_state", "price_evidence_status", "source_route_id", "new_buy_instrument_approved", "entry_rule_status", "maximum_loss_rule_status", "risk_budget_status", "cash_status", "promotion_scope_status", "strategy_draft_status", "execution_state", "primary_reason", "strongest_counter_case", "entry_conditions", "remaining_conditions", "invalidation_conditions", "next_review_trigger", "quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.6.3"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "legal_issuer_name": {"type": "string", "minLength": 1},
    "instrument_type": {"type": "string", "minLength": 1},
    "leveraged_status": {"enum": ["LEVERAGED", "NOT_LEVERAGED", "UNVERIFIED"]},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "market_session": {"type": "string", "format": "date"},
    "research_packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "thesis_status": {"enum": ["PASS", "CONDITIONAL", "FAIL", "UNVERIFIED"]},
    "valuation_status": {"enum": ["PASS", "CONDITIONAL", "REJECTED", "UNVERIFIED"]},
    "technical_status": {"enum": ["READY", "NEAR_TRIGGER", "WATCH", "NOT_READY", "DATA_BLOCKED"]},
    "event_risk_status": {"type": "string", "minLength": 1},
    "risk_liquidity_status": {"enum": ["PASS", "CONDITIONAL", "FAIL", "UNVERIFIED"]},
    "portfolio_fit_status": {"enum": ["PASS", "CONDITIONAL", "BLOCKED", "UNVERIFIED"]},
    "opportunity_state": {"enum": ["READY", "NEAR_TRIGGER", "WATCH", "NOT_READY", "DATA_BLOCKED"]},
    "price_evidence_status": {"enum": ["PRIMARY_VALIDATED", "INDEPENDENT_VERIFIED", "INCONCLUSIVE", "UNAVAILABLE", "PRICE_CONFLICT", "DATA_BLOCKED"]},
    "source_route_id": {"type": ["string", "null"]},
    "new_buy_instrument_approved": {"type": "boolean"},
    "entry_rule_status": {"enum": ["APPROVED", "PENDING", "NOT_APPLICABLE", "BLOCKED"]},
    "maximum_loss_rule_status": {"enum": ["APPROVED", "PENDING", "BLOCKED"]},
    "risk_budget_status": {"enum": ["APPROVED", "PENDING", "BLOCKED"]},
    "cash_status": {"enum": ["VERIFIED_POSITIVE", "VERIFIED_ZERO", "UNVERIFIED", "STALE", "STATE_MISMATCH"]},
    "promotion_scope_status": {"enum": ["APPROVED", "PENDING", "NOT_ELIGIBLE"]},
    "strategy_draft_status": {"enum": ["RESEARCH_ONLY", "PRICE_VERIFICATION_PENDING", "INSTRUMENT_APPROVAL_PENDING", "RISK_POLICY_APPROVAL_PENDING", "CASH_BLOCKED", "PORTFOLIO_BLOCKED", "HUMAN_REVIEW_ELIGIBLE_GUARDED", "DATA_BLOCKED"]},
    "execution_state": {"enum": ["VERIFICATION_PENDING", "NOT_APPROVED", "CASH_BLOCKED", "PORTFOLIO_BLOCKED", "ELIGIBLE_FOR_HUMAN_REVIEW", "WATCH_ONLY", "DATA_BLOCKED"]},
    "primary_reason": {"type": "string", "minLength": 1},
    "strongest_counter_case": {"type": "string", "minLength": 1},
    "entry_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "remaining_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "invalidation_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "next_review_trigger": {"type": "string", "minLength": 1},
    "quantity": {"type": "null"},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  }
}
