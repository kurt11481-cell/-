{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto-core-research-record.schema.json",
  "title": "Research record (workspace/outputs/research-records/<KST date>/research-record.json)",
  "description": "Redesign T2 F3 (prompt D4). Written by the 06:40 integrated check (the only file that task may write). The only path through which LLM research reaches the auto-core. auto_core_inputs.check_record re-checks every item deterministically (https URL on sec.gov or a registry official domain - checked per item, so the schema only asks for a string -, source kind, written_at after 16:00 New York time on the evaluation session and before the decide run, event_session a calendar session, summary_ko at most 200 characters); a failing item is dropped with its reason, a file that fails this schema counts as missing (buys blocked). earnings records follow the p-earn r1 shape read by portfolio_exposure.earnings_blackout. No authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_day_kst", "evaluation_session", "written_at", "writer", "earnings", "official_facts", "integrated_check_run", "order_authority", "quantity_authority"],
  "properties": {
    "schema_version": {"const": "auto-core-research-record-1.0"},
    "record_day_kst": {"type": "string", "format": "date"},
    "evaluation_session": {"type": "string", "format": "date"},
    "written_at": {"type": "string", "format": "date-time"},
    "writer": {"type": "string", "minLength": 1},
    "earnings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "source_kind", "source_url"],
        "properties": {
          "status": {"enum": ["VERIFIED", "NOT_ANNOUNCED"]},
          "announcement_session": {"type": "string", "format": "date"},
          "timing": {"enum": ["BEFORE_OPEN", "AFTER_CLOSE"]},
          "source_kind": {"enum": ["SEC_FILING", "COMPANY_PRESS_RELEASE", "COMPANY_IR"]},
          "source_url": {"type": "string", "minLength": 1},
          "checked_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "official_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "symbol", "direction", "kind", "card_trigger_ids", "event_session", "announced_at", "source_kind", "source_url", "criterion_a", "root_thesis_damage", "summary_ko"],
        "properties": {
          "fact_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{4,80}$"},
          "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,11}$"},
          "direction": {"enum": ["+", "-"]},
          "kind": {"enum": ["contract", "guidance", "revenue", "funding", "dilution", "customer_change", "kill", "thesis", "other"]},
          "card_trigger_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,2}$"}},
          "event_session": {"type": "string", "format": "date"},
          "announced_at": {"type": "string", "format": "date-time"},
          "source_kind": {"enum": ["SEC_FILING", "COMPANY_PRESS_RELEASE", "COMPANY_IR"]},
          "source_url": {"type": "string", "minLength": 1},
          "criterion_a": {"type": "boolean"},
          "root_thesis_damage": {"type": "boolean"},
          "summary_ko": {"type": "string", "minLength": 1}
        }
      }
    },
    "integrated_check_run": {"type": ["object", "null"]},
    "order_authority": {"const": false},
    "quantity_authority": {"const": "none"}
  }
}
