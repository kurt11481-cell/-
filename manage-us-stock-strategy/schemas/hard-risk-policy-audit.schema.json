{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hard-risk-policy-audit.schema.json",
  "title": "Hard-Risk Policy Provenance Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "policy_version", "rules", "overall_status", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.4"},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "rule_version", "ticker", "maximum_loss_fraction", "calculation_basis", "action_on_breach", "approval_status", "approved_by", "approved_at", "user_approval_reference", "average_cost_source_requirement", "action_approval_status", "policy_authority_status", "quantity_authority"],
        "properties": {
          "rule_id": {"type": ["string", "null"]},
          "rule_version": {"type": ["string", "null"]},
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
          "maximum_loss_fraction": {"type": ["number", "null"], "minimum": 0},
          "calculation_basis": {"type": ["string", "null"]},
          "action_on_breach": {"type": ["string", "null"]},
          "approval_status": {"type": "string", "minLength": 1},
          "approved_by": {"type": ["string", "null"]},
          "approved_at": {"type": ["string", "null"]},
          "user_approval_reference": {"type": ["string", "null"]},
          "average_cost_source_requirement": {"type": ["string", "null"]},
          "action_approval_status": {"type": "string", "minLength": 1},
          "policy_authority_status": {"enum": ["VERIFIED", "THRESHOLD_VERIFIED_ACTION_UNVERIFIED", "UNVERIFIED"]},
          "quantity_authority": {"const": "none"}
        }
      }
    },
    "overall_status": {"enum": ["VERIFIED", "PARTIAL", "POLICY_AUTHORITY_UNVERIFIED"]},
    "order_authority": {"const": false}
  }
}
