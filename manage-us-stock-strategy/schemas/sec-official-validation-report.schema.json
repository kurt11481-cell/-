{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEC Official Event Intake validation report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "overall_status", "checks", "company_source_status"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "overall_status": {"enum": ["PASS", "PARTIAL", "BLOCKED"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "detail"],
        "properties": {
          "check": {"type": "string"},
          "status": {"enum": ["PASS", "PARTIAL", "FAIL", "NOT_VERIFIED"]},
          "detail": {"type": "string"}
        }
      }
    },
    "company_source_status": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
