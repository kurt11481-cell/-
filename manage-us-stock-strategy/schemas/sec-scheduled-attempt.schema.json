{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEC Scheduled Shadow attempt evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "task_name",
    "started_at",
    "finished_at",
    "attempt_result",
    "failure_code",
    "freshness_status",
    "current_run_id",
    "last_known_run_id",
    "last_known_run_as_of",
    "diff_status",
    "network_started",
    "sec_live_request_count_if_known",
    "runner_exit_code",
    "scheduler_mode",
    "lookback_days",
    "user_agent_configured",
    "persistent_user_agent_configured",
    "timezone_id",
    "timezone_preflight_status",
    "portfolio_context_status",
    "order_authority",
    "execution_quantity",
    "automatic_order"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_name": {"const": "GuardedPortfolio-SEC-Shadow-v0.1"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "attempt_result": {"enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED"]},
    "failure_code": {
      "type": ["string", "null"],
      "enum": [
        null,
        "WINDOWS_TIMEZONE_MISMATCH",
        "SEC_USER_AGENT_USER_ENV_REQUIRED",
        "SEC_USER_AGENT_REQUIRED",
        "RUNNER_NOT_FOUND",
        "PYTHON_RUNTIME_NOT_FOUND",
        "SEC_ACCESS_BLOCKED",
        "SEC_RATE_LIMITED",
        "SEC_SOURCE_INVALID",
        "SEC_IDENTITY_CONFLICT",
        "NETWORK_SCOPE_VIOLATION",
        "RUN_COLLISION",
        "PROCESS_ERROR"
      ]
    },
    "freshness_status": {"enum": ["CURRENT_RUN", "LAST_KNOWN", "BASELINE_ONLY"]},
    "current_run_id": {"type": ["string", "null"]},
    "last_known_run_id": {"type": ["string", "null"]},
    "last_known_run_as_of": {"type": ["string", "null"], "format": "date-time"},
    "diff_status": {
      "type": ["string", "null"],
      "enum": [null, "PASS", "BASELINE_ONLY", "PREVIOUS_RUN_INCOMPATIBLE", "PREVIOUS_RUN_NOT_FOUND"]
    },
    "network_started": {"type": "boolean"},
    "sec_live_request_count_if_known": {"type": ["integer", "null"], "minimum": 0},
    "runner_exit_code": {"type": ["integer", "null"]},
    "scheduler_mode": {"const": "SCHEDULED_SHADOW"},
    "lookback_days": {"const": 7},
    "user_agent_configured": {"type": "boolean"},
    "persistent_user_agent_configured": {"type": "boolean"},
    "timezone_id": {"type": "string", "minLength": 1},
    "timezone_preflight_status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
    "portfolio_context_status": {"const": "NOT_ACCESSED_BY_SCHEDULED_ATTEMPT"},
    "order_authority": {"const": false},
    "execution_quantity": {"const": null},
    "automatic_order": {"const": false}
  }
}
