{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEC Official Event Intake run manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_version", "run_id", "run_mode", "pipeline_status", "git_branch", "git_commit", "git_worktree_dirty", "started_at", "finished_at", "decision_as_of", "source_contract_urls", "allowed_hosts", "lookback_days", "watchlist", "implementation_hashes", "schema_hashes", "rules_hashes", "raw_source_hashes", "artifact_hashes", "request_accounting", "company_source_status", "event_count", "high_event_count", "ownership_coverage", "portfolio_context_status", "portfolio_context_as_of", "user_agent_configured", "user_agent_sha256", "network_access", "save_access", "broker_call", "portfolio_mutation", "policy_mutation", "task_scheduler_activated", "orders", "order_authority", "execution_quantity", "automatic_order", "protected_input_hashes", "artifact_paths"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "pipeline_version": {"const": "0.1"},
    "run_id": {"type": "string"},
    "run_mode": {"const": "ONE_SHOT_LIVE_SHADOW"},
    "pipeline_status": {"enum": ["PASS", "PARTIAL", "BLOCKED"]},
    "git_branch": {"type": "string"},
    "git_commit": {"type": "string"},
    "git_worktree_dirty": {"type": "boolean"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "decision_as_of": {"type": "string", "format": "date-time"},
    "source_contract_urls": {"type": "object", "additionalProperties": {"type": "string", "format": "uri"}},
    "allowed_hosts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "lookback_days": {"type": "integer", "minimum": 1},
    "watchlist": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "implementation_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "schema_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "rules_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "raw_source_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "artifact_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "request_accounting": {"type": "object"},
    "company_source_status": {"type": "object", "additionalProperties": {"type": "string"}},
    "event_count": {"type": "integer", "minimum": 0},
    "high_event_count": {"type": "integer", "minimum": 0},
    "ownership_coverage": {"enum": ["PARTIAL", "NOT_VERIFIED"]},
    "portfolio_context_status": {"enum": ["LAST_KNOWN", "NOT_VERIFIED"]},
    "portfolio_context_as_of": {"type": ["string", "null"]},
    "user_agent_configured": {"const": true},
    "user_agent_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "network_access": {"const": "SEC_OFFICIAL_ONLY"},
    "save_access": {"const": false},
    "broker_call": {"const": false},
    "portfolio_mutation": {"const": false},
    "policy_mutation": {"const": false},
    "task_scheduler_activated": {"const": false},
    "orders": {"const": "NONE"},
    "order_authority": {"const": false},
    "execution_quantity": {"const": null},
    "automatic_order": {"const": false},
    "protected_input_hashes": {"type": "object"},
    "artifact_paths": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
