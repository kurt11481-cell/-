{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-resolution-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_version", "ticker", "instrument_identity", "decision_as_of", "resolution_status", "holding_compile_mode", "categories", "action_impacts", "resolution_attempt_count", "network_order_calls", "execution_quantity", "quantity_authority", "order_authority", "bundle_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "engine_version": {"const": "EVENT_RESOLUTION_V1"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "instrument_identity": {"type": "object"},
    "decision_as_of": {"type": "string", "format": "date-time"},
    "resolution_status": {"enum": ["RESOLVED", "RESOLVED_WITH_NONBLOCKING_GAPS", "UNRESOLVED_ACTION_BLOCKING", "UNRESOLVED_NONBLOCKING", "INVALID"]},
    "holding_compile_mode": {"enum": ["FULL", "DEGRADED_EVENT_SCOPED", "FAIL_CLOSED", "NOT_RUN"]},
    "categories": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "action_impacts": {"type": "object", "required": ["NEW_BUY", "ADD", "HOLD", "TRIM", "EXIT"]},
    "resolution_attempt_count": {"type": "integer", "minimum": 0},
    "network_order_calls": {"const": 0},
    "execution_quantity": {"const": null},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false},
    "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
