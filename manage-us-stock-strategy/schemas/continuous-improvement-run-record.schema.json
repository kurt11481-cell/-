{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuous-improvement-run-record.schema.json",
  "type": "object",
  "required": ["schema_version", "analytics_engine_version", "metric_definition_version", "run_id", "run_fingerprint", "execution_origin", "decision_mode", "decision_mode_status", "run_provenance_status", "maturity_eligible", "git_sha", "runtime_manifest_hash", "provider_scope_hash", "semantic_cohort", "improvement_analytics_cohort", "decision_as_of", "market_data_cutoff", "event_cutoff", "broker_cutoff", "portfolio_hash_before", "portfolio_hash_after", "source_artifacts", "source_sha256", "decision_artifacts", "temporal_evidence_status", "evaluation_valid", "execution_quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "analytics_engine_version": {"const": "continuous-improvement-engine-2.0"},
    "metric_definition_version": {"const": "continuous-improvement-metrics-2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_fingerprint": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "execution_origin": {"enum": ["SCHEDULED_GENUINE", "MANUAL", "REPLAY", "TEST_ONLY", "SHADOW_COUNTERFACTUAL", "UNVERIFIED"]},
    "decision_mode": {"enum": ["LIVE_READ_ONLY", "MANUAL_READ_ONLY", "REPLAY", "TEST_ONLY", "SHADOW_COUNTERFACTUAL"]},
    "decision_mode_status": {"enum": ["DECISION_MODE_VALID", "DECISION_MODE_MISMATCH"]},
    "run_provenance_status": {"enum": ["VERIFIED_SCHEDULED", "VERIFIED_MANUAL", "VERIFIED_REPLAY", "VERIFIED_TEST", "VERIFIED_SHADOW", "UNVERIFIED"]},
    "maturity_eligible": {"type": "boolean"},
    "git_sha": {"type": "string", "minLength": 7},
    "runtime_manifest_hash": {"type": "string", "minLength": 1},
    "provider_scope_hash": {"type": "string", "minLength": 1},
    "semantic_cohort": {"type": "string", "minLength": 1},
    "improvement_analytics_cohort": {"type": "string", "minLength": 1},
    "decision_as_of": {"type": "string", "format": "date-time"},
    "market_data_cutoff": {"type": "string", "format": "date-time"},
    "event_cutoff": {"type": "string", "format": "date-time"},
    "broker_cutoff": {"type": "string", "format": "date-time"},
    "portfolio_hash_before": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "portfolio_hash_after": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "source_artifacts": {"type": "array"},
    "source_sha256": {"type": "array"},
    "decision_artifacts": {"type": "array"},
    "temporal_evidence_status": {"enum": ["TEMPORAL_EVIDENCE_VALID", "TEMPORAL_EVIDENCE_VIOLATION"]},
    "evaluation_valid": {"type": "boolean"},
    "execution_quantity": {"type": "null"},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  },
  "additionalProperties": true
}
