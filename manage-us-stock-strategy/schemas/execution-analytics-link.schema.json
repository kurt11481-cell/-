{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-analytics-link.schema.json",
  "type": "object",
  "required": ["schema_version", "analytics_engine_version", "metric_definition_version", "artifact_id", "artifact_type", "event_namespace", "source_hash", "broker_truth_mutation", "maturity_eligible", "execution_quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "analytics_engine_version": {"const": "continuous-improvement-engine-3.0"},
    "metric_definition_version": {"const": "continuous-improvement-metrics-3.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"enum": ["ORDER_INTENT", "ACTUAL_ORDER", "BROKER_ACK", "ACTUAL_FILL", "SHADOW_FILL"]},
    "event_namespace": {"enum": ["ACTUAL_BROKER_EVENT", "SHADOW_SIMULATION_EVENT"]},
    "source_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "broker_truth_mutation": {"const": false},
    "maturity_eligible": {"const": false},
    "execution_quantity": {"type": "null"},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  },
  "additionalProperties": false
}
