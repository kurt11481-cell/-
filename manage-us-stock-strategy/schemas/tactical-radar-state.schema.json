{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tactical-radar-state.schema.json",
  "title": "Tactical Radar Runtime State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "last_processed_us_session", "last_run_at", "candidates", "deliveries", "order_authority"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_version": {"type": "string", "minLength": 1},
    "last_processed_us_session": {"type": ["string", "null"], "format": "date"},
    "last_run_at": {"type": ["string", "null"], "format": "date-time"},
    "candidates": {"type": "object", "additionalProperties": {"type": "object"}},
    "deliveries": {"type": "object", "additionalProperties": {"type": "object"}},
    "order_authority": {"const": false}
  }
}
