{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuous-improvement-policy.schema.json",
  "type": "object",
  "required": ["schema_version", "analytics_engine_version", "metric_definition_version", "policy_id", "mode", "run_origin_model", "decision_mode_model", "scheduled_provenance", "forward_outcome_horizons", "completed_trading_sessions_only", "evidence_grades", "eligibility_axes", "archived_evidence_preferred", "live_api_usage", "analytics_failure_affects_core_scheduled_run", "drift_thresholds", "operational_sla_thresholds", "event_resolution_metrics", "production_policy_auto_apply", "execution_analytics", "portfolio_mutation", "execution_quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "analytics_engine_version": {"const": "continuous-improvement-engine-3.0"},
    "metric_definition_version": {"const": "continuous-improvement-metrics-3.0"},
    "policy_id": {"const": "continuous-improvement-sidecar-v4"},
    "run_origin_model": {"type": "object"},
    "decision_mode_model": {"type": "object"},
    "mode": {"const": "SIDECAR_ONLY"},
    "scheduled_provenance": {"type": "object"},
    "forward_outcome_horizons": {"type": "array", "minItems": 4, "uniqueItems": true},
    "completed_trading_sessions_only": {"const": true},
    "evidence_grades": {"type": "object"},
    "eligibility_axes": {"type": "array", "minItems": 4},
    "archived_evidence_preferred": {"const": true},
    "live_api_usage": {"type": "object"},
    "analytics_failure_affects_core_scheduled_run": {"const": false},
    "drift_thresholds": {"const": "NOT_CONFIGURED"},
    "operational_sla_thresholds": {"const": "NOT_CONFIGURED"},
    "event_resolution_metrics": {"type": "object"},
    "production_policy_auto_apply": {"const": false},
    "execution_analytics": {"type": "object"},
    "portfolio_mutation": {"const": false},
    "execution_quantity": {"type": "null"},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  },
  "additionalProperties": false
}
