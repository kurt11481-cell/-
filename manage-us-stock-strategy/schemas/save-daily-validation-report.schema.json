{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAVE Daily validation report v0.1",
  "type": "object",
  "required": ["schema_version", "run_id", "generated_at", "overall_status", "checks"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "overall_status": {"enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check", "status", "detail"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "PARTIAL", "CONFLICTING", "FAIL", "NOT_VERIFIED"]},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
