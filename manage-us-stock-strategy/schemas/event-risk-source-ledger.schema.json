{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-risk-source-ledger.schema.json",
  "title": "Sanitized official-source correction ledger for current event risk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "analysis_cutoff", "checked_at", "evidence_routes", "corrections", "order_authority"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ledger_id": {"type": "string", "minLength": 1},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "checked_at": {"type": "string", "format": "date-time"},
    "evidence_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "ticker", "source_url", "source_type", "checked_at", "verification_status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "ticker": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "source_type": {"enum": ["SEC", "ISSUER_IR", "ETF_SPONSOR", "EXCHANGE", "REGULATOR", "GOVERNMENT"]},
          "checked_at": {"type": "string", "format": "date-time"},
          "verification_status": {"const": "VERIFIED"}
        }
      }
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["correction_id", "target_event_id", "create_if_missing", "claim_ids", "evidence_ids", "event_patch"],
        "properties": {
          "correction_id": {"type": "string", "minLength": 1},
          "target_event_id": {"type": "string", "minLength": 1},
          "replaces_event_id": {"type": ["string", "null"]},
          "create_if_missing": {"type": "boolean"},
          "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "event_patch": {"type": "object"}
        }
      }
    },
    "order_authority": {"const": false}
  }
}
