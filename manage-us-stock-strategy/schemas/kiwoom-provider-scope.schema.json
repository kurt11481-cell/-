{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kiwoom-provider-scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticker", "identity_provider", "regular_close_primary", "extended_hours_primary", "technical_history_primary", "shadow_provider", "blocked_decision_classes", "fallback_reason", "effective_from", "acceptance_artifact_hash", "order_authority"],
  "properties": {
    "ticker": {"type": "string"},
    "identity_provider": {"const": "KIWOOM_REST"},
    "regular_close_primary": {"enum": ["KIWOOM_REGULAR_CLOSE_PRIMARY_WHEN_FINALIZED", "YFINANCE_PRIMARY_VALIDATED_FALLBACK"]},
    "extended_hours_primary": {"const": "KIWOOM_OPERATIONAL_PRIMARY"},
    "technical_history_primary": {"enum": ["KIWOOM_ADJUSTED_LOCAL_DETERMINISTIC", "YFINANCE_PRIMARY_VALIDATED_FALLBACK"]},
    "shadow_provider": {"const": "YFINANCE_DIAGNOSTIC_SHADOW"},
    "blocked_decision_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fallback_reason": {"type": ["string", "null"]},
    "effective_from": {"type": "string", "format": "date-time"},
    "acceptance_artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "order_authority": {"const": false}
  }
}
