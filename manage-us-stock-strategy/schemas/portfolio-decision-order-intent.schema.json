{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-decision-order-intent.schema.json",
  "title": "Portfolio Decision ORDER_INTENT_ONLY Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at",
    "run_state",
    "market_session_date",
    "risk_envelope_version",
    "risk_envelope_sha256",
    "decision_plan_version",
    "broker_snapshot_id",
    "input_hashes",
    "input_provenance_digest",
    "decision_digest",
    "semantic_digest",
    "trigger_provenance",
    "request_accounting_status",
    "order_endpoint_evidence",
    "instructions",
    "run_blockers",
    "delivery",
    "submission_status",
    "order_authority",
    "execution_quantity",
    "automatic_order",
    "broker_submission",
    "portfolio_mutation",
    "record_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "PORTFOLIO_DECISION_ORDER_INTENT_ONLY"},
    "generated_at": {"type": "string", "format": "date-time"},
    "run_state": {
      "enum": ["ORDER_INSTRUCTION_READY", "NO_ORDER", "ORDER_BLOCKED", "ORDER_EXPIRED", "RUN_FAILED"]
    },
    "market_session_date": {"type": ["string", "null"], "format": "date"},
    "risk_envelope_version": {"type": ["string", "null"]},
    "risk_envelope_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "decision_plan_version": {"type": ["string", "null"]},
    "broker_snapshot_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "input_provenance_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semantic_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trigger_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_type",
        "run_provenance_status",
        "actual_scheduled_run",
        "scheduled_occurrence_id",
        "operational_grade",
        "scheduled_maturity_promoted"
      ],
      "properties": {
        "trigger_type": {"enum": ["MANUAL_GENUINE", "SCHEDULED_GENUINE"]},
        "run_provenance_status": {"enum": ["VERIFIED_MANUAL", "VERIFIED_SCHEDULED_GENUINE", "NOT_VERIFIED"]},
        "actual_scheduled_run": {"type": "boolean"},
        "scheduled_occurrence_id": {"type": ["string", "null"]},
        "operational_grade": {"enum": ["GRADE_B", "GRADE_A_CANDIDATE", "NOT_VERIFIED"]},
        "scheduled_maturity_promoted": {"const": false}
      }
    },
    "request_accounting_status": {"enum": ["VERIFIED_DATA_ACQUISITION_ONLY", "PARTIAL", "NOT_VERIFIED"]},
    "order_endpoint_evidence": {"enum": ["STATICALLY_BLOCKED", "PARTIAL", "NOT_VERIFIED"]},
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction_id",
          "state",
          "generated_at",
          "market_session_date",
          "valid_from",
          "valid_until",
          "ticker",
          "instrument_identity",
          "side",
          "proposed_quantity",
          "order_type",
          "limit_price",
          "approved_price_rule",
          "time_in_force",
          "canonical_reference_price",
          "price_timestamp",
          "market_phase",
          "current_position_quantity",
          "current_position_weight",
          "target_position_quantity",
          "target_position_weight",
          "estimated_order_value",
          "verified_orderable_cash",
          "decision_reason",
          "why_now",
          "decision_change_trigger",
          "thesis_status",
          "kill_condition",
          "risk_envelope_version",
          "decision_plan_version",
          "broker_snapshot_id",
          "input_provenance_digest",
          "decision_digest",
          "risk_gate_status",
          "authority_status",
          "submission_status",
          "order_authority",
          "execution_quantity",
          "automatic_order",
          "broker_submission",
          "portfolio_mutation",
          "blockers",
          "record_hash"
        ],
        "properties": {
          "instruction_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "state": {"enum": ["ORDER_INSTRUCTION_READY", "NO_ORDER", "ORDER_BLOCKED", "ORDER_EXPIRED"]},
          "generated_at": {"type": "string", "format": "date-time"},
          "market_session_date": {"type": ["string", "null"], "format": "date"},
          "valid_from": {"type": ["string", "null"], "format": "date-time"},
          "valid_until": {"type": ["string", "null"], "format": "date-time"},
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
          "instrument_identity": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "canonical_ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
              "instrument_class": {"type": "string", "minLength": 1},
              "leverage_factor": {"type": "number", "minimum": 0},
              "growth_ai_semiconductor_cluster": {"type": "boolean"},
              "mapping_source": {"type": "string", "minLength": 1},
              "identity_authority_status": {"enum": ["VERIFIED", "NOT_VERIFIED"]},
              "identity_authority_id": {"type": ["string", "null"]},
              "identity_registry_version": {"type": ["string", "null"]},
              "identity_registry_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
            }
          },
          "side": {"enum": ["BUY", "SELL", null]},
          "proposed_quantity": {"type": ["integer", "null"], "minimum": 1},
          "order_type": {"enum": ["LIMIT", "PRICE_RULE", null]},
          "limit_price": {"type": ["number", "null"], "minimum": 0},
          "approved_price_rule": {"type": ["string", "null"]},
          "time_in_force": {"enum": ["DAY", null]},
          "canonical_reference_price": {"type": ["number", "null"], "minimum": 0},
          "price_timestamp": {"type": ["string", "null"], "format": "date-time"},
          "market_phase": {"type": ["string", "null"]},
          "current_position_quantity": {"type": ["integer", "null"], "minimum": 0},
          "current_position_weight": {"type": ["number", "null"], "minimum": 0},
          "target_position_quantity": {"type": ["integer", "null"], "minimum": 0},
          "target_position_weight": {"type": ["number", "null"], "minimum": 0},
          "estimated_order_value": {"type": ["number", "null"], "minimum": 0},
          "verified_orderable_cash": {"type": ["number", "null"], "minimum": 0},
          "decision_reason": {"type": "string", "minLength": 1},
          "why_now": {"type": ["string", "null"]},
          "decision_change_trigger": {"type": ["string", "null"]},
          "thesis_status": {"enum": ["ACTIVE", "IMPAIRED", "KILLED", "NOT_APPLICABLE", null]},
          "kill_condition": {"type": ["string", "null"]},
          "risk_envelope_version": {"type": ["string", "null"]},
          "decision_plan_version": {"type": ["string", "null"]},
          "broker_snapshot_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "input_provenance_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "decision_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "risk_gate_status": {"enum": ["PASS", "BLOCKED", "NOT_APPLICABLE"]},
          "authority_status": {"const": "ORDER_INTENT_ONLY_NO_EXECUTION_AUTHORITY"},
          "submission_status": {"const": "NOT_SUBMITTED"},
          "order_authority": {"const": false},
          "execution_quantity": {"type": "null"},
          "automatic_order": {"const": false},
          "broker_submission": {"const": "DISABLED"},
          "portfolio_mutation": {"const": false},
          "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "run_blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "delivery_id", "status", "delivery_attempted", "delivery_successful", "failure_isolated"],
      "properties": {
        "channel": {"const": "EXISTING_AUTOMATION_DELIVERY"},
        "delivery_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["ELIGIBLE", "NOT_ELIGIBLE", "DUPLICATE_SUPPRESSED", "DELIVERY_FAILED"]},
        "delivery_attempted": {"type": "boolean"},
        "delivery_successful": {"type": "boolean"},
        "failure_isolated": {"const": true}
      }
    },
    "submission_status": {"const": "NOT_SUBMITTED"},
    "order_authority": {"const": false},
    "execution_quantity": {"type": "null"},
    "automatic_order": {"const": false},
    "broker_submission": {"const": "DISABLED"},
    "portfolio_mutation": {"const": false},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
