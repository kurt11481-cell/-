{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mvll-canonical-volume-lineage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lineage_id", "ticker", "provider", "source_api_id", "completed_session", "market_phase", "bar_finalized", "finalization_basis", "minimum_stable_observations", "stable_observation_count", "source_artifact_sha256", "source_artifact_path", "price_volume_basis", "window_sessions", "denominator_sessions", "signal_session", "formula_version", "canonical_rvol20", "threshold", "yfinance_diagnostic_rvol20", "cross_provider_divergence", "divergence_blocking", "volume_authority_status", "technical_condition_status", "lineage_classification", "semantic_change", "observations", "quantity", "quantity_authority", "order_authority", "record_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lineage_id": {"const": "MVLL_CANONICAL_VOLUME_LINEAGE"},
    "ticker": {"const": "MVLL"},
    "provider": {"const": "KIWOOM"},
    "source_api_id": {"const": "usa06012"},
    "completed_session": {"type": ["string", "null"]},
    "market_phase": {"const": "REGULAR_COMPLETED"},
    "bar_finalized": {"type": "boolean"},
    "finalization_basis": {"const": "TERMINAL_STABLE_SUFFIX_SAME_PROVIDER"},
    "minimum_stable_observations": {"type": "integer", "minimum": 2},
    "stable_observation_count": {"type": "integer", "minimum": 0},
    "source_artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "source_artifact_path": {"type": ["string", "null"]},
    "price_volume_basis": {"const": "ADJUSTED_PRICE_WITH_RAW_EQUAL_DAILY_VOLUME"},
    "window_sessions": {"type": "array", "items": {"type": "string"}},
    "denominator_sessions": {"type": "array", "items": {"type": "string"}},
    "signal_session": {"type": ["string", "null"]},
    "formula_version": {"const": "RVOL20_SIGNAL_VOLUME_DIV_PRIOR_20_SESSION_MEAN_V1"},
    "canonical_rvol20": {"type": ["number", "null"], "minimum": 0},
    "threshold": {"type": "number", "minimum": 0.000001},
    "yfinance_diagnostic_rvol20": {"type": ["number", "null"], "minimum": 0},
    "cross_provider_divergence": {"type": ["number", "null"]},
    "divergence_blocking": {"const": false},
    "volume_authority_status": {"enum": ["KIWOOM_VALID_SCOPED", "KIWOOM_LINEAGE_UNVERIFIED"]},
    "technical_condition_status": {"enum": ["READY", "RVOL20_NOT_MET", "NOT_EVALUATED"]},
    "lineage_classification": {"enum": ["DATA_CORRECTION", "SEMANTIC_CHANGE"]},
    "semantic_change": {"type": "boolean"},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "quantity": {"const": null},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
