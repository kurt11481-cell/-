{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issuer-valuation-snapshot.schema.json",
  "title": "Point-in-Time Issuer Valuation Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "valuation_snapshot_id", "ticker", "issuer_name", "entity_role", "analysis_cutoff", "market_session", "price", "capitalization", "balance_sheet", "operating_metrics", "derived_values", "valuation_methods", "valuation_scenarios", "claim_ids", "evidence_ids", "required_missing_inputs", "calculation_formula_version", "staleness_status", "staleness_triggers", "valuation_evidence_status", "valuation_judgement_status", "snapshot_hash", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.6.12"},
    "valuation_snapshot_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "issuer_name": {"type": "string", "minLength": 1},
    "entity_role": {"enum": ["DIRECT_ISSUER", "UNDERLYING_ISSUER"]},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "market_session": {"type": "string", "format": "date"},
    "price": {"type": "object"},
    "capitalization": {"type": "object"},
    "balance_sheet": {"type": "object"},
    "operating_metrics": {"type": "object"},
    "derived_values": {"type": "object"},
    "valuation_methods": {"type": "array", "items": {"type": "object"}},
    "valuation_scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "valuation-scenario.schema.json"}},
    "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_missing_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "calculation_formula_version": {"type": "string", "minLength": 1},
    "staleness_status": {"enum": ["FRESH", "STALE", "INVALID"]},
    "staleness_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "valuation_evidence_status": {"enum": ["UNVERIFIED", "PARTIAL", "SCENARIO_VALIDATED", "DIRECT_SCENARIO_VALIDATED", "PRICE_EVIDENCE_CONFLICT", "STALE", "INVALID", "NOT_APPLICABLE"]},
    "valuation_judgement_status": {"enum": ["ATTRACTIVE", "FAIR", "STRETCHED", "UNCLASSIFIED", "UNVERIFIED", "NOT_APPLICABLE"]},
    "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "order_authority": {"const": false}
  }
}
