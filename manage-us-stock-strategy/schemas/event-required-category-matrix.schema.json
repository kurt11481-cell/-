{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-required-category-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "ticker_requirements", "product_events_may_be_replaced_by_underlying_events", "historical_backfill_authority", "portfolio_mutation_authority", "quantity_authority", "execution_quantity", "order_authority"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_version": {"type": "string", "minLength": 1},
    "ticker_requirements": {
      "type": "object",
      "required": ["SOXL", "MVLL", "NBIS"],
      "additionalProperties": {
        "type": "object",
        "required": ["instrument_scope", "categories"],
        "properties": {
          "instrument_scope": {"type": "string", "minLength": 1},
          "supplemental_underlying": {"type": "string"},
          "categories": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirement", "blocking_actions"],
              "properties": {
                "requirement": {"enum": ["REQUIRED", "OPTIONAL", "NOT_APPLICABLE"]},
                "blocking_actions": {"type": "array", "items": {"enum": ["NEW_BUY", "ADD", "HOLD", "TRIM", "EXIT"]}, "uniqueItems": true}
              }
            }
          }
        }
      }
    },
    "product_events_may_be_replaced_by_underlying_events": {"const": false},
    "historical_backfill_authority": {"const": false},
    "portfolio_mutation_authority": {"const": false},
    "quantity_authority": {"const": "none"},
    "execution_quantity": {"const": null},
    "order_authority": {"const": false}
  }
}
