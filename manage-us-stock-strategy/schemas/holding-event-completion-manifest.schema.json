{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holding-event-completion-manifest.schema.json",
  "title": "Holding event completion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "market_session", "analysis_cutoff",
    "change_classification", "active_bundle_id", "active_bundle_file_hash",
    "successor_bundle_id", "successor_bundle_path", "successor_bundle_file_hash",
    "successor_bundle_canonical_hash", "source_ledger_path", "source_ledger_canonical_hash",
    "baseline_event_links", "active_baseline_index_hash", "active_bundle_mutated",
    "active_baseline_index_mutated", "portfolio_state_hash_before",
    "portfolio_state_hash_after", "portfolio_mutated", "provider_readiness_mutated",
    "strategy_state_mutated", "baseline_activation_mutated", "quantity_authority",
    "order_authority"
  ],
  "properties": {
    "schema_version": {"const": "2.6.13"},
    "manifest_id": {"type": "string", "minLength": 1},
    "market_session": {"type": "string", "format": "date"},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "change_classification": {"const": "DATA_ONLY"},
    "active_bundle_id": {"type": "string", "minLength": 1},
    "active_bundle_file_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "successor_bundle_id": {"type": "string", "minLength": 1},
    "successor_bundle_path": {"type": "string", "minLength": 1},
    "successor_bundle_file_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "successor_bundle_canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ledger_path": {"type": "string", "minLength": 1},
    "source_ledger_canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_event_links": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "baseline_id", "path", "file_hash", "link_hash", "validation_status"],
        "properties": {
          "ticker": {"enum": ["SOXL", "MVLL", "NBIS", "MRVL"]},
          "baseline_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "file_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "link_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "validation_status": {"const": "PASSED"}
        }
      }
    },
    "active_baseline_index_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "active_bundle_mutated": {"const": false},
    "active_baseline_index_mutated": {"const": false},
    "portfolio_state_hash_before": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "portfolio_state_hash_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "portfolio_mutated": {"const": false},
    "provider_readiness_mutated": {"const": false},
    "strategy_state_mutated": {"const": false},
    "baseline_activation_mutated": {"const": false},
    "quantity_authority": {"const": false},
    "order_authority": {"const": false}
  }
}
