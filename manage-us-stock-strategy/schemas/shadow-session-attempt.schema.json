{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadow-session-attempt.schema.json",
  "title": "Append-Only Integrated Shadow Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "attempt_type", "run_phase", "automation_name", "attempted_at", "completed_session", "official_session_status", "delivery_status", "delivery_id", "git_commit", "branch", "working_tree_clean", "deployment_status", "registry_status", "portfolio_hash_before", "portfolio_hash_after", "baseline_coverage", "independent_price_coverage", "price_evidence_queue_status", "live_strategy_hash", "shadow_strategy_hash", "critical_violations", "exclusion_reasons", "counts_as_valid_session", "previous_attempt_hash", "attempt_hash", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.6"},
    "attempt_id": {"type": "string", "minLength": 1},
    "attempt_type": {"enum": ["SCHEDULED_POST_MARKET", "MANUAL_SMOKE_RUN", "UNIT_TEST", "PRE_OPEN", "HISTORICAL_REPLAY"]},
    "run_phase": {"enum": ["POST_MARKET", "PRE_OPEN"]},
    "automation_name": {"type": "string"},
    "attempted_at": {"type": "string", "format": "date-time"},
    "completed_session": {"type": ["string", "null"], "format": "date"},
    "official_session_status": {"type": "string"},
    "delivery_status": {"type": "string"},
    "delivery_id": {"type": ["string", "null"]},
    "expected_scheduled_session": {"type": "boolean"},
    "historical_backfill": {"type": "boolean"},
    "git_commit": {"type": "string"},
    "branch": {"type": "string"},
    "working_tree_clean": {"type": "boolean"},
    "deployment_status": {"type": "string"},
    "registry_status": {"type": "string"},
    "run_manifest_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "report_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "portfolio_hash_before": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "portfolio_hash_after": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "baseline_coverage": {"type": "object"},
    "independent_price_coverage": {"type": "object"},
    "price_evidence_queue_status": {"type": "string"},
    "live_strategy_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "shadow_strategy_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "artifact_references": {"type": "object"},
    "critical_violations": {"type": "array", "items": {"type": "string"}},
    "exclusion_reasons": {"type": "array", "items": {"type": "string"}},
    "counts_as_valid_session": {"type": "boolean"},
    "previous_attempt_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "attempt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "order_authority": {"const": false}
  }
}
