{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "future-order-shadow.schema.json",
  "type": "object",
  "required": ["schema_version", "order_authority", "record_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "quantity": {"const": null},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false},
    "network_send": {"const": false},
    "portfolio_mutation": {"const": false},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
