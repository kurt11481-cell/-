{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw-web-close-evidence.schema.json",
  "title": "Untrusted Raw Codex Web Completed-Close Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "queue_item_id", "ticker", "security_name", "reported_session", "reported_close", "currency", "price_basis", "provider", "source_url", "final_source_url", "source_domain", "source_type", "source_title", "source_field_label", "retrieved_at", "source_timestamp", "acquisition_method", "is_search_snippet", "is_yahoo_origin", "security_identity_match_claim", "regular_session_close_claim", "extracted_text", "extracted_text_sha256", "evidence_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.6"},
    "queue_item_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "security_name": {"type": "string", "minLength": 1},
    "reported_session": {"type": "string", "format": "date"},
    "reported_close": {"type": "number", "minimum": 0},
    "currency": {"const": "USD"},
    "price_basis": {"enum": ["RAW_REGULAR_SESSION_CLOSE", "CONSOLIDATED_REGULAR_SESSION_CLOSE", "OFFICIAL_LISTING_MARKET_CLOSE", "ADJUSTED_CLOSE", "INTRADAY_PRICE", "PREMARKET_PRICE", "AFTER_HOURS_PRICE", "UNKNOWN"]},
    "provider": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "final_source_url": {"type": "string", "format": "uri"},
    "source_domain": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_title": {"type": "string", "minLength": 1},
    "source_field_label": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "source_timestamp": {"type": "string", "format": "date-time"},
    "acquisition_method": {"const": "CODEX_WEB"},
    "is_search_snippet": {"const": false},
    "is_yahoo_origin": {"const": false},
    "security_identity_match_claim": {"const": true},
    "regular_session_close_claim": {"const": true},
    "extracted_text": {"type": "string", "minLength": 1},
    "extracted_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_authority": {"const": "UNTRUSTED_WEB_EVIDENCE"},
    "order_authority": {"const": false}
  }
}
