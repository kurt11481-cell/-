{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-reallocation-shadow.schema.json",
  "title": "Capital Reallocation Shadow Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "validation_mode",
    "completed_bar_finalization_status",
    "event_refresh_status",
    "event_bundle_hash",
    "decision_provenance",
    "status",
    "policy_version",
    "portfolio_decision_semantic_cohort",
    "portfolio_reallocation_cycle_id",
    "canonical_positive_holding_tickers",
    "same_cycle_duplicate_suppressed",
    "decision_as_of",
    "market_data_cutoff",
    "event_cutoff",
    "broker_cutoff",
    "candidate_cutoff",
    "post_close_ordering_status",
    "ordering_errors",
    "holding_decisions",
    "expected_sale_proceeds_usd",
    "expected_sale_proceeds_status",
    "verified_actual_cash_usd",
    "verified_orderable_cash_from_expected_proceeds_usd",
    "hypothetical_cash_usd_after_sale",
    "hypothetical_cash_status",
    "funding_authority",
    "expected_proceeds_may_fund_candidate",
    "capital_availability_status",
    "portfolio_risk_before",
    "portfolio_risk_after",
    "portfolio_risk_after_basis",
    "optimizer_input_status",
    "hypothetical_post_sale_portfolio",
    "candidate_comparison",
    "keep_cash_alternative",
    "best_shadow_decision",
    "best_shadow_candidate",
    "decision_rationale",
    "portfolio_turnover_status",
    "reallocation_cooldown_status",
    "rotation_justification",
    "sell_risk_decision",
    "buy_risk_decision",
    "future_execution_state_compatibility",
    "execution_quantity",
    "quantity_authority",
    "order_authority",
    "portfolio_mutation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "CAPITAL_REALLOCATION_SHADOW"},
    "validation_mode": {"enum": ["LIVE_READ_ONLY", "TEST_ONLY"]},
    "completed_bar_finalization_status": {"const": "KIWOOM_COMPLETED_BAR_FINALIZED"},
    "event_refresh_status": {"const": "POST_CLOSE_EVENT_REFRESH_VALIDATED"},
    "event_bundle_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "decision_provenance": {"type": "object"},
    "status": {"enum": ["CAPITAL_REALLOCATION_SHADOW_VERIFIED", "INVALID"]},
    "policy_version": {"type": "string", "minLength": 1},
    "portfolio_decision_semantic_cohort": {"type": "string", "minLength": 1},
    "portfolio_reallocation_cycle_id": {"type": "string", "minLength": 1},
    "canonical_positive_holding_tickers": {
      "type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"}, "uniqueItems": true
    },
    "same_cycle_duplicate_suppressed": {"type": "boolean"},
    "decision_as_of": {"type": "string", "format": "date-time"},
    "market_data_cutoff": {"type": "string", "format": "date-time"},
    "event_cutoff": {"type": "string", "format": "date-time"},
    "broker_cutoff": {"type": "string", "format": "date-time"},
    "candidate_cutoff": {"type": ["string", "null"], "format": "date-time"},
    "post_close_ordering_status": {"enum": ["PASS", "FAIL"]},
    "ordering_errors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "holding_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "ticker",
          "ADD_CASE",
          "HOLD_CASE",
          "TRIM_CASE",
          "EXIT_CASE",
          "selected_holding_action",
          "event_actionability",
          "hypothetical_sell_quantity",
          "expected_sale_proceeds_status",
          "execution_quantity",
          "quantity_authority",
          "order_authority",
          "state_axes",
          "decision_provenance"
        ],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
          "ADD_CASE": {"type": "object"},
          "HOLD_CASE": {"type": "object"},
          "TRIM_CASE": {"type": "object"},
          "EXIT_CASE": {"type": "object"},
          "selected_holding_action": {
            "enum": [
              "HOLD_CORE", "HOLD_TIGHTEN_STOP", "ADD_REVIEW",
              "TRIM_PROFIT", "TRIM_VALUATION", "TRIM_TECHNICAL",
              "TRIM_CONCENTRATION", "TRIM_RISK", "EXIT_THESIS",
              "EXIT_HARD_STOP", "ROTATE_REVIEW"
            ]
          },
          "event_actionability": {"type": "object"},
          "hypothetical_sell_quantity": {"type": ["integer", "null"], "minimum": 1},
          "expected_sale_proceeds_status": {"const": "SHADOW_ONLY"},
          "execution_quantity": {"const": null},
          "quantity_authority": {"const": "none"},
          "order_authority": {"const": false},
          "state_axes": {"type": "object"},
          "decision_provenance": {"type": "object"}
        }
      }
    },
    "expected_sale_proceeds_usd": {"type": "number", "minimum": 0},
    "expected_sale_proceeds_status": {"const": "SHADOW_ONLY"},
    "verified_actual_cash_usd": {"type": "number", "minimum": 0},
    "verified_orderable_cash_from_expected_proceeds_usd": {"const": 0},
    "hypothetical_cash_usd_after_sale": {"type": "number", "minimum": 0},
    "hypothetical_cash_status": {"const": "SHADOW_ONLY"},
    "funding_authority": {"const": "VERIFIED_ACTUAL_CASH_ONLY"},
    "expected_proceeds_may_fund_candidate": {"const": false},
    "capital_availability_status": {"type": "string", "minLength": 1},
    "portfolio_risk_before": {"type": "object"},
    "portfolio_risk_after": {"type": "object"},
    "portfolio_risk_after_basis": {"const": "SHADOW_POST_SALE_ONLY"},
    "optimizer_input_status": {"type": "object", "additionalProperties": {"enum": ["AVAILABLE", "UNAVAILABLE", "NOT_APPLICABLE"]}},
    "hypothetical_post_sale_portfolio": {"type": "array", "items": {"type": "object"}},
    "candidate_comparison": {"type": "array", "items": {"type": "object"}},
    "keep_cash_alternative": {"type": "object"},
    "best_shadow_decision": {"enum": ["ADD_EXISTING_REVIEW", "NEW_BUY_REVIEW", "KEEP_CASH", "ROTATE_REVIEW"]},
    "best_shadow_candidate": {"type": ["string", "null"]},
    "decision_rationale": {"type": "string", "minLength": 1},
    "portfolio_turnover_status": {"type": "string", "minLength": 1},
    "reallocation_cooldown_status": {"type": "string", "minLength": 1},
    "rotation_justification": {"type": ["string", "null"]},
    "sell_risk_decision": {"enum": ["RISK_REVIEW_REQUIRED", "NOT_APPLICABLE"]},
    "buy_risk_decision": {"enum": ["RISK_REVIEW_REQUIRED", "NOT_APPLICABLE"]},
    "future_execution_state_compatibility": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "execution_quantity": {"const": null},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false},
    "portfolio_mutation": {"const": false}
  }
}
