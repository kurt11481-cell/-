{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-only-scheduler-diagnostic.schema.json",
  "title": "TEST_ONLY Durable Scheduler Diagnostic Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_plane_version",
    "diagnostic_mode",
    "status",
    "generated_at",
    "occurrence",
    "result",
    "event_types",
    "ledger_path",
    "ledger_sha256",
    "host_clock",
    "protected_hashes_before",
    "protected_hashes_after",
    "protected_state_unchanged",
    "production_runtime_invoked",
    "portfolio_effect",
    "core_counter_effect",
    "test_only",
    "maturity_eligible",
    "order_authority",
    "quantity_authority",
    "execution_quantity",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "control_plane_version": {"const": "test-only-durable-control-plane-v1"},
    "diagnostic_mode": {"enum": ["DIAGNOSTIC_A", "DIAGNOSTIC_B"]},
    "status": {"enum": ["PASS", "FAIL"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "occurrence": {
      "type": "object",
      "required": [
        "occurrence_id", "schedule_id", "scheduled_run_id", "phase", "trading_date",
        "scheduled_fire_at", "scheduled_fire_at_new_york", "scheduler_origin",
        "scheduler_config_hash", "trigger_created_at", "calendar_source",
        "calendar_verified", "test_only", "maturity_eligible", "order_authority",
        "quantity_authority", "execution_quantity"
      ],
      "properties": {
        "occurrence_id": {"type": "string", "minLength": 16},
        "schedule_id": {"type": "string"},
        "scheduled_run_id": {"type": "string"},
        "phase": {"enum": ["PRE_OPEN_T_MINUS_30", "REGULAR_CLOSE_T_PLUS_30"]},
        "trading_date": {"type": "string", "format": "date"},
        "scheduled_fire_at": {"type": "string", "format": "date-time"},
        "scheduled_fire_at_new_york": {"type": "string", "format": "date-time"},
        "scheduler_origin": {"const": "TEST_ONLY_DURABLE_LOCAL_SCHEDULER"},
        "scheduler_config_hash": {"type": "string"},
        "trigger_created_at": {"type": "string", "format": "date-time"},
        "calendar_source": {"const": "TEST_ONLY_SYNTHETIC_EXCHANGE_CALENDAR"},
        "calendar_verified": {"const": true},
        "test_only": {"const": true},
        "maturity_eligible": {"const": false},
        "order_authority": {"const": false},
        "quantity_authority": {"const": "none"},
        "execution_quantity": {"type": "null"}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "occurrence_id", "status", "test_only", "maturity_eligible", "runtime_started",
        "order_authority", "quantity_authority", "execution_quantity"
      ],
      "properties": {
        "occurrence_id": {"type": "string"},
        "status": {"enum": ["DISPATCH_SUCCEEDED", "LAUNCH_SUCCEEDED", "LAUNCH_FAILED", "CLOCK_INTEGRITY_FAILED", "MISSED", "DUPLICATE_SUPPRESSED", "STALE_TRIGGER_REJECTED", "CRASH_AFTER_FIRE_BEFORE_LAUNCH"]},
        "dispatch_result": {"enum": ["PASS", "FAIL"]},
        "failure_stage": {"type": ["string", "null"]},
        "failure_reason": {},
        "launcher_started_at": {"type": "string", "format": "date-time"},
        "launcher_finished_at": {"type": "string", "format": "date-time"},
        "launcher_exit_code": {"type": ["integer", "null"]},
        "diagnostic_artifact_path": {"type": ["string", "null"]},
        "diagnostic_artifact_sha256": {"type": ["string", "null"]},
        "test_only": {"const": true},
        "maturity_eligible": {"const": false},
        "runtime_started": {"const": false},
        "order_authority": {"const": false},
        "quantity_authority": {"const": "none"},
        "execution_quantity": {"type": "null"}
      },
      "additionalProperties": false
    },
    "event_types": {"type": "array", "items": {"type": "string"}},
    "ledger_path": {"type": "string"},
    "ledger_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "host_clock": {"type": "object"},
    "protected_hashes_before": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-F0-9]{64}$"}},
    "protected_hashes_after": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-F0-9]{64}$"}},
    "protected_state_unchanged": {"const": true},
    "production_runtime_invoked": {"const": false},
    "portfolio_effect": {"const": "NONE"},
    "core_counter_effect": {"const": "NONE"},
    "test_only": {"const": true},
    "maturity_eligible": {"const": false},
    "order_authority": {"const": false},
    "quantity_authority": {"const": "none"},
    "execution_quantity": {"type": "null"},
    "artifact_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
