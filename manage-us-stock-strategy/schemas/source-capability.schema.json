{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-capability.schema.json",
  "title": "Source Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "providers", "circuit_breaker"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_version": {"type": "string", "minLength": 1},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "source_type", "live_supported", "historical_point_in_time_supported", "timestamp_quality", "authoritative_for", "independent_crosscheck_eligible", "rate_limit_notes", "failure_behavior", "fallback_priority", "enabled", "capability_scope", "limitations"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["primary", "market_data", "secondary", "social"]},
          "live_supported": {"type": ["boolean", "string"]},
          "historical_point_in_time_supported": {"type": ["boolean", "string"]},
          "timestamp_quality": {"type": "string", "minLength": 1},
          "authoritative_for": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "independent_crosscheck_eligible": {"type": "boolean"},
          "rate_limit_notes": {"type": "string"},
          "failure_behavior": {"type": "string", "minLength": 1},
          "fallback_priority": {"type": "integer", "minimum": 0},
          "enabled": {"type": "boolean"},
          "capability_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "role": {"type": "string", "minLength": 1},
          "activation_status": {"type": "string", "minLength": 1},
          "acceptance_artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "order_authority": {"const": false}
        }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "open_after_consecutive_failures", "failure_types", "retry_storm_prohibited", "ip_rotation_prohibited", "silent_stale_fallback_prohibited"],
      "properties": {
        "states": {"type": "array", "items": {"enum": ["HEALTHY", "DEGRADED", "OPEN"]}, "minItems": 3, "uniqueItems": true},
        "open_after_consecutive_failures": {"type": "integer", "minimum": 1},
        "failure_types": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "retry_storm_prohibited": {"const": true},
        "ip_rotation_prohibited": {"const": true},
        "silent_stale_fallback_prohibited": {"const": true}
      }
    }
  }
}
