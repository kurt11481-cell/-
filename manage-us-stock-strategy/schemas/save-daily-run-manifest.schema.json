{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAVE Daily run manifest v0.1",
  "type": "object",
  "required": ["schema_version", "run_id", "pipeline_version", "run_mode", "pipeline_status", "started_at", "finished_at", "source_path", "source_sha256", "source_file_size", "source_page_count", "source_accessed_at", "report_date", "source_validation_status", "extraction_status", "schedule_status", "event_count", "material_event_count", "portfolio_context_status", "portfolio_context_as_of", "network_access", "save_login", "task_scheduler_activated", "broker_call", "portfolio_mutation", "policy_mutation", "request_accounting", "orders", "order_authority", "execution_quantity", "automatic_order", "artifact_paths"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "pipeline_version": {"const": "0.1"},
    "run_mode": {"const": "OFFLINE_REPLAY"},
    "pipeline_status": {"enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "minLength": 64},
    "source_file_size": {"type": "integer", "minimum": 1},
    "source_page_count": {"type": "integer", "minimum": 1},
    "source_accessed_at": {"type": "string", "format": "date-time"},
    "report_title": {"type": ["string", "null"]},
    "report_date": {"type": "string", "format": "date"},
    "source_validation_status": {"enum": ["PASS", "PARTIAL", "CONFLICTING", "BLOCKED"]},
    "extraction_status": {"enum": ["PASS", "PARTIAL", "BLOCKED"]},
    "schedule_status": {"enum": ["PASS", "PARTIAL", "CONFLICTING", "BLOCKED"]},
    "schedule_auto_use": {"enum": ["YES", "NO"]},
    "visual_validation": {"enum": ["PASS", "NOT_VERIFIED"]},
    "schedule_observations": {"type": "array", "items": {"type": "object"}},
    "event_count": {"type": "integer", "minimum": 0},
    "material_event_count": {"type": "integer", "minimum": 0},
    "portfolio_context_status": {"const": "LAST_KNOWN"},
    "portfolio_context_as_of": {"type": ["string", "null"]},
    "network_access": {"const": "NO"},
    "save_login": {"const": "NO"},
    "task_scheduler_activated": {"const": "NO"},
    "broker_call": {"const": "NO"},
    "portfolio_mutation": {"const": "NO"},
    "policy_mutation": {"const": "NO"},
    "request_accounting": {"const": "NOT_VERIFIED"},
    "orders": {"const": "NONE"},
    "order_authority": {"const": false},
    "execution_quantity": {"type": "null"},
    "automatic_order": {"const": false},
    "git_branch": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "minLength": 1},
    "code_provenance": {"type": "object"},
    "implementation_provenance": {"type": "object"},
    "dependency_provenance": {"type": "object"},
    "artifact_hashes": {"type": "object"},
    "static_path_evidence": {"type": "object"},
    "protected_input_hashes": {"type": "object"},
    "artifact_paths": {"type": "object"}
  },
  "additionalProperties": false
}
