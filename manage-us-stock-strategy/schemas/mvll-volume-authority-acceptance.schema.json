{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mvll-volume-authority-acceptance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ticker", "data_class", "decision_class", "market_session", "acceptance_status", "volume_authority_status", "technical_condition_status", "kiwoom_rvol20", "yfinance_rvol20", "threshold", "same_session_window", "volume_semantics", "identity_status", "missing_bar_count", "duplicate_session_count", "raw_adjusted_volume_match", "corporate_action_status", "source_artifacts", "diagnostic_divergence", "blocking", "volume_averaged", "record_hash", "quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ticker": {"const": "MVLL"},
    "data_class": {"const": "DAILY_VOLUME"},
    "decision_class": {"const": "RVOL20"},
    "market_session": {"type": "string", "format": "date"},
    "acceptance_status": {"enum": ["VALID", "INVALID"]},
    "volume_authority_status": {"enum": ["KIWOOM_VALID_SCOPED", "UNRESOLVED"]},
    "technical_condition_status": {"enum": ["READY", "RVOL20_NOT_MET", "INVALID"]},
    "kiwoom_rvol20": {"type": ["number", "null"], "minimum": 0},
    "yfinance_rvol20": {"type": ["number", "null"], "minimum": 0},
    "threshold": {"type": "number", "minimum": 0.000001},
    "same_session_window": {"type": "boolean"},
    "volume_semantics": {"const": "SESSION_AGGREGATED_DAILY_VOLUME_AS_REPORTED_BY_KIWOOM_USA06012"},
    "identity_status": {"enum": ["VERIFIED", "INVALID"]},
    "missing_bar_count": {"type": "integer", "minimum": 0},
    "duplicate_session_count": {"type": "integer", "minimum": 0},
    "raw_adjusted_volume_match": {"type": "boolean"},
    "corporate_action_status": {"enum": ["NO_UNRESOLVED_ACTION", "AMBIGUOUS"]},
    "source_artifacts": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "diagnostic_divergence": {"type": ["number", "null"]},
    "blocking": {"const": false},
    "volume_averaged": {"const": false},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quantity": {"const": null},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  }
}
