{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-strategy-report.schema.json",
  "title": "Combined Morning Portfolio Strategy Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_phase", "generated_at", "analysis_cutoff", "market_session", "data_status", "holding_data_status", "tactical_data_status", "event_data_status", "holding_risk_data_status", "holding_strategy_data_status", "independent_close_data_status", "broker_state_status", "capital_redeployment_status", "provider_health", "global_failures", "holding_risk_result", "holding_strategies", "tactical_radar_result", "cash_funding_state", "capital_redeployment", "final_portfolio_strategy", "notifications", "component_artifacts", "deterministic_gate_result", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.4"},
    "run_phase": {"const": "POST_MARKET"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "market_session": {"type": ["string", "null"], "format": "date"},
    "data_status": {"enum": ["VALIDATED", "PARTIAL", "DATA_INCOMPLETE"]},
    "holding_data_status": {"enum": ["VALIDATED", "PARTIAL", "DATA_INCOMPLETE"]},
    "tactical_data_status": {"enum": ["VALIDATED", "PARTIAL", "DATA_INCOMPLETE"]},
    "event_data_status": {"enum": ["COMPLETE", "PARTIAL", "EVENT_DATA_INCOMPLETE"]},
    "holding_risk_data_status": {"enum": ["VALIDATED", "PARTIAL", "DATA_INCOMPLETE"]},
    "holding_strategy_data_status": {"enum": ["VALIDATED", "PARTIAL", "DATA_INCOMPLETE"]},
    "independent_close_data_status": {"enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE"]},
    "broker_state_status": {"enum": ["VERIFIED_POSITIVE", "VERIFIED_ZERO", "UNVERIFIED", "STALE", "STATE_MISMATCH"]},
    "capital_redeployment_status": {"enum": ["FUNDED_REVIEW_AVAILABLE", "NO_FUNDED_ACTION", "DATA_BLOCKED"]},
    "provider_health": {"type": "object"},
    "global_failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "holding_risk_result": {"type": "object"},
    "holding_strategies": {"type": "array", "items": {"$ref": "holding-strategy.schema.json"}, "minItems": 1},
    "tactical_radar_result": {"type": "object"},
    "cash_funding_state": {"type": "object"},
    "capital_redeployment": {"$ref": "capital-redeployment-plan.schema.json"},
    "final_portfolio_strategy": {"type": "object"},
    "notifications": {"type": "array", "items": {"type": "object"}},
    "component_artifacts": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "deterministic_gate_result": {"enum": ["PASS", "WAIT", "DATA_BLOCKED", "HARD_RISK_REVIEW"]},
    "order_authority": {"const": false}
  }
}
