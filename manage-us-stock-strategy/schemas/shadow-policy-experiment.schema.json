{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadow-policy-experiment.schema.json",
  "type": "object",
  "required": ["schema_version", "analytics_engine_version", "metric_definition_version", "status", "current_production_policy_hash", "shadow_policy_candidate_hash", "eligible_evidence_hashes", "out_of_sample_evidence_hashes", "identical_evidence_required", "production_policy_mutation", "portfolio_mutation", "operational_counter_mutation", "auto_apply", "execution_quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "analytics_engine_version": {"const": "continuous-improvement-engine-2.0"},
    "metric_definition_version": {"const": "continuous-improvement-metrics-2.0"},
    "status": {"const": "SHADOW_POLICY_EXPERIMENT_VERIFIED"},
    "current_production_policy_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "shadow_policy_candidate_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "eligible_evidence_hashes": {"type": "array"},
    "out_of_sample_evidence_hashes": {"type": "array"},
    "identical_evidence_required": {"const": true},
    "production_policy_mutation": {"const": false},
    "portfolio_mutation": {"const": false},
    "operational_counter_mutation": {"const": false},
    "auto_apply": {"const": false},
    "execution_quantity": {"type": "null"},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  },
  "additionalProperties": false
}
