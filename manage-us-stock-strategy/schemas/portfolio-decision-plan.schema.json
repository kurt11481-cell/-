{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-decision-plan.schema.json",
  "title": "Portfolio Decision Dashboard Explicit Plan Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "as_of",
    "plan_status",
    "evidence_binding",
    "target_type",
    "positions",
    "material_unknowns",
    "decision_change_triggers"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "as_of": {"type": "string", "format": "date-time"},
    "plan_status": {
      "enum": ["CURRENT_APPROVED", "PROVISIONAL", "HISTORICAL", "REPLAY_ONLY"]
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_run_id", "expected_decision_as_of"],
      "properties": {
        "expected_run_id": {"type": "string", "minLength": 8},
        "expected_decision_as_of": {"type": "string", "format": "date-time"}
      }
    },
    "post_sell_refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_run_id", "prior_decision_as_of"],
      "properties": {
        "prior_run_id": {"type": "string", "minLength": 8},
        "prior_decision_as_of": {"type": "string", "format": "date-time"}
      }
    },
    "target_type": {
      "enum": [
        "MINIMUM_SAFETY_REFERENCE",
        "TRANSITIONAL_RISK_FEASIBLE_TARGET",
        "RECOMMENDED_FEASIBLE_TARGET",
        "PROVISIONAL_FULL_TARGET_REFERENCE"
      ]
    },
    "cash_target_pct": {"type": "number", "minimum": 0},
    "buy_priority": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
      "uniqueItems": true
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "action",
          "rationale",
          "investment_horizon",
          "target_status"
        ],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
          "action": {"enum": ["ADD", "HOLD", "TRIM", "EXIT"]},
          "target_weight_pct": {"type": "number", "minimum": 0},
          "rationale": {"type": "string", "minLength": 1},
          "investment_horizon": {"type": "string", "minLength": 1},
          "target_status": {"enum": ["APPROVED", "PROVISIONAL", "HISTORICAL", "BLOCKED"]},
          "evidence_reference": {"type": ["string", "null"]},
          "thesis_kill": {"type": "boolean"},
          "material_risk": {"type": ["string", "null"]},
          "order_intent_terms": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "terms_status",
              "production_target_approval_status",
              "proposed_quantity",
              "order_type",
              "limit_price",
              "approved_price_rule",
              "time_in_force",
              "valid_from",
              "valid_until",
              "why_now",
              "decision_change_trigger",
              "thesis_status",
              "kill_condition",
              "funding_source"
            ],
            "properties": {
              "terms_status": {"const": "APPROVED_ORDER_INTENT_ONLY"},
              "production_target_approval_status": {"const": "APPROVED_PRODUCTION_TARGET"},
              "proposed_quantity": {"type": "integer", "minimum": 1},
              "order_type": {"enum": ["LIMIT", "PRICE_RULE"]},
              "limit_price": {"type": ["number", "null"], "minimum": 0},
              "approved_price_rule": {"type": ["string", "null"]},
              "time_in_force": {"enum": ["DAY"]},
              "valid_from": {"type": "string", "format": "date-time"},
              "valid_until": {"type": "string", "format": "date-time"},
              "why_now": {"type": "string", "minLength": 1},
              "decision_change_trigger": {"type": "string", "minLength": 1},
              "thesis_status": {"enum": ["ACTIVE", "IMPAIRED", "KILLED", "NOT_APPLICABLE"]},
              "kill_condition": {"type": ["string", "null"]},
              "funding_source": {"enum": ["VERIFIED_ORDERABLE_CASH", "PENDING_SELL_PROCEEDS", "NOT_APPLICABLE"]}
            }
          },
          "decision_change_triggers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "material_unknowns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "decision_change_triggers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
