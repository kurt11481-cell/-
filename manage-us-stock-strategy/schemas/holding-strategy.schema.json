{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holding-strategy.schema.json",
  "title": "Verified Holding Strategy Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_phase", "ticker", "holding_verified", "current_shares", "average_cost_usd", "market_value_usd", "analysis_cutoff", "market_session", "strategy_state", "execution_state", "thesis_status", "valuation_status", "technical_status", "event_risk_status", "risk_status", "holding_risk_state", "portfolio_fit_status", "primary_reason", "claim_ids", "strongest_counter_case", "remaining_conditions", "add_conditions", "reduce_conditions", "invalidation", "next_review_trigger", "quantity", "quantity_authority", "policy_rule_id", "policy_approval_status", "policy_authority_status", "action_on_breach", "primary_close_status", "independent_close_status", "price_verification_status", "crosscheck_requirement", "crosscheck_status", "crosscheck_method", "effective_price_status", "execution_constraints", "threshold_authority_status", "breach_observation_status", "independent_confirmation_status", "breach_action_authority_status", "leveraged_confirmation", "display_action_code", "primary_reason_code", "tranche_id", "trigger_path", "research_packet_hash", "snapshot_hash", "event_snapshot_hash", "policy_version", "strategy_version", "hard_risk_active", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.5"},
    "run_phase": {"const": "POST_MARKET"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "holding_verified": {"const": true},
    "current_shares": {"type": "integer", "minimum": 1},
    "average_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "market_value_usd": {"type": ["number", "null"], "minimum": 0},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "market_session": {"type": ["string", "null"], "format": "date"},
    "strategy_state": {"enum": ["HOLD", "ADD_ON_WATCH", "ADD_REVIEW", "REDUCTION_REVIEW", "EXIT_REVIEW", "STRATEGY_REFRESH_REQUIRED", "DATA_BLOCKED"]},
    "execution_state": {"enum": ["ELIGIBLE_FOR_REVIEW", "VERIFICATION_PENDING", "HUMAN_REVIEW_REQUIRED", "WATCH_ONLY", "CASH_BLOCKED", "POLICY_BLOCKED", "PORTFOLIO_BLOCKED", "DATA_BLOCKED", "NOT_APPLICABLE"]},
    "thesis_status": {"enum": ["VALID", "CONTESTED", "INVALIDATED", "STALE", "UNVERIFIED"]},
    "valuation_status": {"enum": ["ATTRACTIVE", "FAIR", "STRETCHED", "STALE", "UNVERIFIED"]},
    "technical_status": {"enum": ["READY", "WATCH", "DETERIORATING", "INVALID", "UNAVAILABLE"]},
    "event_risk_status": {"enum": ["CLEAR", "KNOWN_EVENT", "EVENT_DATA_INCOMPLETE"]},
    "risk_status": {"enum": ["ACCEPTABLE", "CONSTRAINED", "HARD_RISK", "VETO", "UNVERIFIED"]},
    "holding_risk_state": {"enum": ["NO_HARD_RISK", "HARD_RISK_WATCH", "HARD_RISK_BREACH", "POLICY_AUTHORITY_UNVERIFIED", "DATA_BLOCKED"]},
    "portfolio_fit_status": {"enum": ["FITS", "CONSTRAINED", "BLOCKED", "UNVERIFIED"]},
    "primary_reason": {"type": "string", "minLength": 1},
    "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "strongest_counter_case": {"type": ["string", "null"]},
    "remaining_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "add_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reduce_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "invalidation": {"type": ["string", "null"]},
    "next_review_trigger": {"type": "string", "minLength": 1},
    "quantity": {"type": ["integer", "null"], "minimum": 1},
    "quantity_authority": {"enum": ["none", "deterministic_existing_policy"]},
    "policy_rule_id": {"type": ["string", "null"]},
    "policy_approval_status": {"type": "string", "minLength": 1},
    "policy_authority_status": {"enum": ["VERIFIED", "THRESHOLD_VERIFIED_ACTION_UNVERIFIED", "UNVERIFIED"]},
    "action_on_breach": {"type": ["string", "null"]},
    "primary_close_status": {"enum": ["VERIFIED", "UNAVAILABLE"]},
    "independent_close_status": {"enum": ["NOT_REQUIRED", "PENDING", "VERIFIED", "UNAVAILABLE", "INCONCLUSIVE", "CONFLICT"]},
    "price_verification_status": {"enum": ["PRIMARY_VALIDATED", "INDEPENDENT_VERIFIED", "KIWOOM_CANONICAL_COMPLETED_CLOSE", "PRICE_CONFLICT", "DATA_BLOCKED"]},
    "crosscheck_requirement": {"enum": ["NOT_REQUIRED", "REQUIRED"]},
    "crosscheck_status": {"enum": ["NOT_REQUIRED", "PENDING", "VERIFIED", "UNAVAILABLE", "INCONCLUSIVE", "CONFLICT"]},
    "crosscheck_method": {"enum": ["NONE", "CODEX_WEB", "STRUCTURED_API"]},
    "effective_price_status": {"enum": ["PRIMARY_VALIDATED", "INDEPENDENT_VERIFIED", "KIWOOM_CANONICAL_COMPLETED_CLOSE", "PRICE_CONFLICT", "DATA_BLOCKED"]},
    "execution_constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "threshold_authority_status": {"enum": ["VERIFIED", "UNVERIFIED"]},
    "breach_observation_status": {"enum": ["NO_PRIMARY_BREACH", "PRIMARY_BREACH_OBSERVED"]},
    "independent_confirmation_status": {"enum": ["NOT_REQUIRED", "PENDING", "VERIFIED", "UNAVAILABLE", "INCONCLUSIVE", "CONFLICT"]},
    "breach_action_authority_status": {"enum": ["VERIFIED", "UNVERIFIED"]},
    "leveraged_confirmation": {"type": "object"},
    "display_action_code": {"enum": ["HOLD_NO_ACTION", "ADD_WAIT", "ADD_REVIEW", "ADD_PRICE_CHECK", "REDUCE_REVIEW", "EXIT_REVIEW", "RISK_REVIEW", "STRATEGY_REVIEW", "DATA_ISSUE", "BROKER_SNAPSHOT_REQUIRED", "BROKER_CONFIRMATION_REQUIRED"]},
    "primary_reason_code": {"type": "string", "minLength": 1},
    "tranche_id": {"type": ["string", "null"]},
    "trigger_path": {"type": ["string", "null"]},
    "research_packet_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "event_snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "strategy_version": {"type": "string", "minLength": 1},
    "hard_risk_active": {"type": "boolean"},
    "order_authority": {"const": false}
  }
}
