{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holding-card.schema.json",
  "title": "Holding Card (analysis only, no order authority)",
  "description": "Analysis card written by Cowork. It borrows the field names of portfolio-decision-plan.schema.json (positions[action, rationale, thesis_kill, material_risk], evidence_binding) but is a separate contract. It has no plan_status, order_intent_terms, proposed_quantity, limit_price or target_weight_pct, and dashboard never accepts it as a plan. Cross-field rules (reason tags, withheld reasons, rule agreement, confidence cap, fact-pack equality) live in validate_holding_card.py because the repository schema dialect has no conditionals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "as_of",
    "evidence_binding",
    "fact_pack_sha256",
    "header",
    "positions"
  ],
  "properties": {
    "card_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "as_of": {"type": "string", "format": "date-time"},
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_run_id", "expected_decision_as_of"],
      "properties": {
        "expected_run_id": {"type": "string", "minLength": 8},
        "expected_decision_as_of": {"type": "string", "format": "date-time"}
      }
    },
    "fact_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion_primary", "conclusion_secondary", "status", "exposure", "upcoming_events"],
      "properties": {
        "conclusion_primary": {"type": "string", "minLength": 1},
        "conclusion_secondary": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "exposure": {"type": "string", "minLength": 1},
        "upcoming_events": {"type": "string", "minLength": 1},
        "market_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "label", "lines"],
          "properties": {
            "status": {"enum": ["SAVE_PROVIDED", "SAVE_NOT_RECEIVED"]},
            "label": {"const": "EXTERNAL_REFERENCE"},
            "lines": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "action",
          "conviction",
          "rationale",
          "rule_result",
          "rule_agreement",
          "cash_and_alternatives",
          "numbers",
          "thesis",
          "thesis_kill",
          "material_risk",
          "kill_criteria",
          "next_event",
          "change_conditions",
          "data_status",
          "past_performance"
        ],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
          "action": {"enum": ["ADD", "HOLD", "TRIM", "EXIT", "WITHHELD"]},
          "conviction": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "rationale": {"type": "string", "minLength": 1},
          "reason_tag": {
            "enum": [
              "TRIM_CONCENTRATION",
              "TRIM_RISK",
              "TRIM_TECHNICAL",
              "TRIM_PROFIT",
              "TRIM_VALUATION",
              "EXIT_HARD_STOP",
              "EXIT_THESIS",
              "ROTATE_REVIEW",
              "KEEP_CASH"
            ]
          },
          "review_required": {"type": "boolean"},
          "withheld_reason": {"enum": ["BROKER_UNAVAILABLE", "IDENTITY_UNVERIFIED"]},
          "rule_result": {"type": "string", "minLength": 1},
          "rule_agreement": {"enum": ["SAME", "DIFFERENT"]},
          "rule_disagreement_reason": {"type": "string", "minLength": 1},
          "cash_and_alternatives": {"type": "string", "minLength": 1},
          "numbers": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "held_quantity",
              "average_cost_usd",
              "mark_price_usd",
              "market_value_usd",
              "unrealized_pnl_usd",
              "unrealized_pnl_pct",
              "weight_pct",
              "leverage_factor",
              "confirmed_close_usd",
              "loss_limit_boundary_usd",
              "loss_limit_remaining_pct"
            ],
            "properties": {
              "held_quantity": {"type": ["number", "null"]},
              "average_cost_usd": {"type": ["number", "null"]},
              "mark_price_usd": {"type": ["number", "null"]},
              "market_value_usd": {"type": ["number", "null"]},
              "unrealized_pnl_usd": {"type": ["number", "null"]},
              "unrealized_pnl_pct": {"type": ["number", "null"]},
              "weight_pct": {"type": ["number", "null"]},
              "leverage_factor": {"type": ["number", "null"]},
              "confirmed_close_usd": {"type": ["number", "null"]},
              "loss_limit_boundary_usd": {"type": ["number", "null"]},
              "loss_limit_remaining_pct": {"type": ["number", "null"]}
            }
          },
          "thesis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "status", "change_vs_previous"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "status": {"enum": ["VALID", "CONTESTED", "INVALIDATED", "STALE", "UNVERIFIED"]},
              "change_vs_previous": {"type": "string", "minLength": 1}
            }
          },
          "thesis_kill": {"type": "boolean"},
          "material_risk": {"type": "string", "minLength": 1},
          "kill_criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conditions", "current_distance"],
            "properties": {
              "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "current_distance": {"type": "string", "minLength": 1}
            }
          },
          "next_event": {"type": "string", "minLength": 1},
          "change_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "data_status": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "missing"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "missing": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "past_performance": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
