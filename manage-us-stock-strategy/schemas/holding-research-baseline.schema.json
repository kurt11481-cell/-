{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holding-research-baseline.schema.json",
  "title": "Immutable Shadow Holding Research Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "baseline_version", "ticker", "baseline_type", "analysis_cutoff", "evidence_cutoff", "content_status", "thesis_status", "valuation_applicability", "valuation_status", "valuation_basis", "fundamental_risk_status", "primary_reason", "strongest_counter_case", "invalidation_conditions", "next_research_triggers", "claims", "evidence", "claim_ids", "evidence_ids", "research_packet_hash", "baseline_hash", "supersedes_baseline_id", "validation_status", "evidence_packet_validation", "deterministic_research_gate", "risk_controller_result", "point_in_time_status", "research_recommendation", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.6"},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "integer", "minimum": 1},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "baseline_type": {"enum": ["ISSUER_EQUITY", "SINGLE_STOCK_LEVERAGED_ETF", "SECTOR_LEVERAGED_ETF"]},
    "analysis_cutoff": {"type": "string", "format": "date-time"},
    "evidence_cutoff": {"type": "string", "format": "date-time"},
    "content_status": {"enum": ["COMPLETE", "PARTIAL", "INSUFFICIENT", "STALE", "INVALID"]},
    "thesis_status": {"enum": ["VALID", "CONTESTED", "INVALIDATED", "STALE", "UNVERIFIED"]},
    "valuation_applicability": {"enum": ["DIRECT", "UNDERLYING_BASED", "NOT_APPLICABLE_TO_PRODUCT"]},
    "valuation_status": {"enum": ["ATTRACTIVE", "FAIR", "STRETCHED", "STALE", "UNVERIFIED", "NOT_APPLICABLE"]},
    "valuation_basis": {"enum": ["NBIS_ISSUER", "MRVL_ISSUER", "SEMICONDUCTOR_SECTOR_REGIME"]},
    "fundamental_risk_status": {"enum": ["ACCEPTABLE", "CONSTRAINED", "VETO", "UNVERIFIED"]},
    "primary_reason": {"type": "string", "minLength": 1},
    "strongest_counter_case": {"type": "string", "minLength": 1},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "next_research_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "linked_components": {"type": "array", "items": {"type": "object"}},
    "technical_view_at_baseline": {"type": ["string", "null"]},
    "portfolio_fit_view_at_baseline": {"type": ["string", "null"]},
    "research_packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "supersedes_baseline_id": {"type": ["string", "null"]},
    "validation_status": {"enum": ["DRAFT", "VALIDATED_SHADOW", "PARTIAL_REFRESH_REQUIRED", "REFRESH_REQUIRED", "REJECTED"]},
    "activated_at": {"type": "string", "format": "date-time"},
    "evidence_packet_validation": {"const": "PASSED"},
    "deterministic_research_gate": {"const": "PASSED"},
    "risk_controller_result": {"enum": ["ALLOW_REVIEW", "DOWNGRADE", "VETO"]},
    "point_in_time_status": {"enum": ["PASSED", "FAILED"]},
    "research_recommendation": {"enum": ["MAINTAIN", "REASSESS", "RISK_ESCALATION", "POTENTIAL_ADD_CASE", "POTENTIAL_REDUCTION_CASE"]},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false}
  }
}
