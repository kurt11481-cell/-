{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holding-baseline-activation-receipt.schema.json",
  "title": "Atomic Holding Baseline Shadow Activation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "ticker", "mode", "activated_at", "activation_session", "baseline_id", "baseline_hash", "compile_hash", "price_authority_hash", "valuation_snapshot_hash", "event_link_hash", "prior_index_hash", "new_index_hash", "observation_hash", "required_valid_sessions", "valid_sessions", "backfill", "historical_sessions", "portfolio_hash_before", "portfolio_hash_after", "policy_hash_before", "policy_hash_after", "live_runtime_hash_before", "live_runtime_hash_after", "quantity", "quantity_authority", "order_authority", "validation_status", "receipt_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "ticker": {"enum": ["NBIS", "MVLL"]},
    "mode": {"const": "SHADOW"},
    "activated_at": {"type": "string", "format": "date-time"},
    "activation_session": {"type": "string", "format": "date"},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compile_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "price_authority_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "valuation_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_link_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prior_index_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "new_index_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "required_valid_sessions": {"const": 5},
    "valid_sessions": {"const": 0},
    "backfill": {"const": false},
    "historical_sessions": {"type": "array", "items": {"type": "string"}},
    "portfolio_hash_before": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "portfolio_hash_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_hash_before": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_hash_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "live_runtime_hash_before": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "live_runtime_hash_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quantity": {"const": null},
    "quantity_authority": {"const": "none"},
    "order_authority": {"const": false},
    "validation_status": {"enum": ["NBIS_V2_SHADOW_ACTIVATION_VERIFIED", "MVLL_VALIDATED_SHADOW_WITH_DECISION_CLASS_BLOCK"]},
    "technical_boundary_block": {"type": "string", "minLength": 1},
    "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
