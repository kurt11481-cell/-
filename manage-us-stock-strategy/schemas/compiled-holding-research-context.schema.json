{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compiled-holding-research-context.schema.json",
  "title": "Deterministic Shadow Holding Research Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "ticker", "research_packet_hash", "baseline_hash", "overlay_hash", "baseline_content_status", "thesis_status", "valuation_status", "valuation_applicability", "valuation_basis", "technical_status", "risk_status", "portfolio_fit_status", "strategy_signal", "strategy_state", "primary_reason", "strongest_counter_case", "invalidation", "next_review_trigger", "claim_ids", "remaining_conditions", "quantity", "quantity_authority", "order_authority"],
  "properties": {
    "schema_version": {"const": "2.6"},
    "mode": {"const": "SHADOW_ONLY"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=-]{1,24}$"},
    "research_packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "overlay_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_content_status": {"enum": ["COMPLETE", "PARTIAL", "INSUFFICIENT", "STALE", "INVALID"]},
    "thesis_status": {"enum": ["VALID", "CONTESTED", "INVALIDATED", "STALE", "UNVERIFIED"]},
    "valuation_status": {"enum": ["ATTRACTIVE", "FAIR", "STRETCHED", "STALE", "UNVERIFIED", "NOT_APPLICABLE"]},
    "valuation_applicability": {"enum": ["DIRECT", "UNDERLYING_BASED", "NOT_APPLICABLE_TO_PRODUCT"]},
    "valuation_basis": {"enum": ["NBIS_ISSUER", "MRVL_ISSUER", "SEMICONDUCTOR_SECTOR_REGIME"]},
    "technical_status": {"enum": ["READY", "WATCH", "DETERIORATING", "INVALID", "UNAVAILABLE"]},
    "risk_status": {"enum": ["ACCEPTABLE", "CONSTRAINED", "HARD_RISK", "VETO", "UNVERIFIED"]},
    "portfolio_fit_status": {"enum": ["FITS", "CONSTRAINED", "BLOCKED", "UNVERIFIED"]},
    "strategy_signal": {"enum": ["NONE", "ADD_CANDIDATE", "REDUCE_CANDIDATE", "EXIT_CANDIDATE"]},
    "strategy_state": {"enum": ["HOLD", "ADD_ON_WATCH", "ADD_REVIEW", "REDUCTION_REVIEW", "EXIT_REVIEW", "STRATEGY_REFRESH_REQUIRED", "DATA_BLOCKED"]},
    "primary_reason": {"type": "string", "minLength": 1},
    "strongest_counter_case": {"type": "string", "minLength": 1},
    "invalidation": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "next_review_trigger": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "claim_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "remaining_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "quantity": {"type": ["integer", "null"], "minimum": 1},
    "quantity_authority": {"enum": ["none", "deterministic_existing_policy"]},
    "order_authority": {"const": false}
  }
}
