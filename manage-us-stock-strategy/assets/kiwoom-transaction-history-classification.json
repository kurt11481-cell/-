{
  "schema_version": "1.0",
  "api_id": "ust21100",
  "purpose": "S5 R6: classify saved Kiwoom transaction-history rows. Dividends, fees, taxes and interest (deposit usage fee) are not external cash flows, even when the memo also says deposit or withdrawal. Also, corporate-action rows (par-value split/merge transfers and fractional-share cash) are not external cash flows. A row that matches no rule, or whose direction is unknown or ambiguous, is unresolved and fails closed.",
  "status": "dividend_trade_split_and_fractional_cash_strings_verified_2026_10_02_transfer_and_fx_strings_unobserved",
  "rule_order": "first_match_wins",
  "rules": [
    {
      "classification": "DIVIDEND",
      "fields": ["deal_kind_nm", "rmrk_nm"],
      "match_any": ["배당"]
    },
    {
      "classification": "FEE_TAX_INTEREST",
      "fields": ["deal_kind_nm", "rmrk_nm"],
      "match_any": ["수수료", "세금", "제세", "세액", "원천징수", "이용료", "이자"]
    },
    {
      "classification": "CORPORATE_ACTION",
      "fields": ["deal_kind_nm", "rmrk_nm"],
      "match_any": ["액면", "단주대금"]
    },
    {
      "classification": "FX",
      "fields": ["deal_kind_nm", "rmrk_nm"],
      "match_any": ["환전"],
      "sign_fields": ["rmrk_nm"],
      "sign_rules": [
        {"sign": "+", "match_any": ["입금", "매수"]},
        {"sign": "-", "match_any": ["출금", "매도"]}
      ]
    },
    {
      "classification": "TRADE",
      "fields": ["deal_kind_nm", "rmrk_nm"],
      "match_any": ["매매", "매수", "매도"]
    },
    {
      "classification": "TRANSFER",
      "fields": ["rmrk_nm"],
      "match_any": ["입금", "출금"],
      "sign_fields": ["rmrk_nm"],
      "sign_rules": [
        {"sign": "+", "match_any": ["입금"]},
        {"sign": "-", "match_any": ["출금"]}
      ]
    }
  ]
}
